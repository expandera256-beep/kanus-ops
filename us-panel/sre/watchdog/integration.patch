+"""Adapter: KAN GCEProvider (kanus/gce_provider.py) -> SRE Watchdog provider interface.
+Not deployed. Requires KAN + Demir approval (see SRE_WATCHDOG_DESIGN_20261106.md)."""
+from kanus.gce_provider import GCEProvider
+
+
+class GCEWatchdogProvider:
+    def __init__(self, policy, provider=None):
+        self.policy, self.p = policy, provider or GCEProvider()
+        self._op = 0
+
+    def get_status(self) -> str:          # live instances.get, no cache (§4.11)
+        return self.p.describe(self.policy)["status"]
+
+    def start(self) -> None:              # GCEProvider.start is idempotent for RUNNING/STAGING
+        self._op += 1
+        self.p.start(self.policy, f"sre-wd-start-{self._op}")
+
+    def stop(self) -> None:               # idempotent for TERMINATED/STOPPING
+        self._op += 1
+        self.p.stop(self.policy, f"sre-wd-stop-{self._op}")
+
+
+def make_legacy_check(read_controller_flag):
+    """Handover guard. read_controller_flag() returns instance metadata 'ds-controller'
+    (KAN sets it). Anything other than 'sre-watchdog' (incl. missing/error) = legacy active."""
+    def legacy_active() -> bool:
+        try:
+            return read_controller_flag() != "sre-watchdog"
+        except Exception:  # noqa: BLE001
+            return True
+    return legacy_active
