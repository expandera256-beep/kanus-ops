        "key": "startup-script",
        "value": "#!/bin/bash\nset -eu\nexec > /var/log/usta-l4-setup.log 2>&1\necho \"boot $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\nfor i in $(seq 1 40); do\n  if nvidia-smi >/dev/null 2>&1; then\n    echo \"nvidia ready on try $i\"\n    break\n  fi\n  echo \"waiting for nvidia $i\"\n  sleep 5\ndone\nnvidia-smi\nsystemctl enable ollama\nif curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null; then\n  echo \"ollama already listening, leave it running\"\nelse\n  systemctl restart ollama\n  for i in $(seq 1 30); do\n    if curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null; then\n      break\n    fi\n    sleep 2\n  done\nfi\nif ! sudo -u ollama env HOME=/usr/share/ollama /usr/local/bin/ollama list | grep -q usta-q5; then\n  echo \"usta-q5 missing\"\n  exit 1\nfi\necho \"usta-q5 present $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\ntouch /var/log/usta-l4-setup.done\n"
