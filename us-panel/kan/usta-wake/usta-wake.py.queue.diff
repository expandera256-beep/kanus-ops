+# Demir 2026-11-08 00:30: a start that arrives while ds-a100 is STOPPING is
+# queued (at most one) and fired once the VM reaches TERMINATED.
+PENDING_POLL = 5
+PENDING_LIMIT = 5 * 60
+PENDING_LOCK = threading.Lock()
+PENDING: dict = {"since": 0.0}
+SLEEP = time.sleep
+CLOCK = time.time
+
+
+def a100_pending() -> dict:
+    with PENDING_LOCK:
+        since = PENDING["since"]
+    return {"pending_start": bool(since), "pending_since": int(since) if since else None}
+
+
+def a100_queue_start() -> bool:
+    """Record one pending start. Returns False if one is already pending."""
+    with PENDING_LOCK:
+        if PENDING["since"]:
+            return False
+        PENDING["since"] = CLOCK()
+
+    def run() -> None:
+        worker = WORKERS["a100"]
+        deadline = CLOCK() + PENDING_LIMIT
+        outcome = "expired"
+        try:
+            while CLOCK() < deadline:
+                try:
+                    status = instance_status(worker)
+                except Exception:  # noqa: BLE001
+                    status = "UNKNOWN"
+                if power_verb(status) == "start":
+                    try:
+                        a100_start_now()
+                        outcome = "started"
+                    except Exception as exc:  # noqa: BLE001
+                        outcome = "start_failed:" + type(exc).__name__
+                    return
+                if status in ("RUNNING", "STAGING", "PROVISIONING"):
+                    outcome = "already_" + status.lower()
+                    return
+                SLEEP(PENDING_POLL)
+        finally:
+            with PENDING_LOCK:
+                PENDING["since"] = 0.0
+            print("a100 pending start", outcome, flush=True)
+
+    threading.Thread(target=run, daemon=True).start()
+    return True
+
