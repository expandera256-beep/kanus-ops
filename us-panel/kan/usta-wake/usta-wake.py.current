#!/usr/bin/env python3
"""Always-on door. Wakes the chosen worker, then streams the request through."""

from __future__ import annotations

import json
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

PROJECT = "project-27082a40-6083-4952-9db"
PORT = 80
WORKER_PORT = 8788
WAKE_LIMIT = 20 * 60

WORKERS = {
    "q8": {
        "id": "q8",
        "name": "Q8 işlemci",
        "kind": "cpu",
        "zone": "us-central1-c",
        "instance": "instance-20261030-232245",
        "backend": "10.128.0.2",
    },
    "q5": {
        "id": "q5",
        "name": "Q5 ekran kartı",
        "kind": "gpu",
        "zone": "us-central1-a",
        "instance": "usta-l4",
        "backend": "10.128.0.6",
    },
    "a100": {
        "id": "a100",
        "name": "DeepSeek A100",
        "kind": "gpu",
        "zone": "europe-west4-b",
        "instance": "ds-a100",
        "backend": "10.164.0.6",
        "wake_limit": 50 * 60,
        "discard_local_ssd": True,
    },
}
LOCKS = {key: threading.Lock() for key in WORKERS}
GPU_LOCK = threading.Lock()


def worker_id(path: str, header: str) -> str:
    raw = (header or "").strip().lower()
    if not raw:
        query = parse_qs(urlparse(path).query)
        picked = query.get("worker") or []
        raw = picked[0].strip().lower() if picked else ""
    if raw in WORKERS:
        return raw
    return "q8"


def power_verb(status: str) -> str:
    if status in ("RUNNING", "STAGING", "PROVISIONING"):
        return ""
    if status == "SUSPENDED":
        return "resume"
    if status in ("TERMINATED", "STOPPED"):
        return "start"
    return ""


def token() -> str:
    req = urllib.request.Request(
        "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token",
        headers={"Metadata-Flavor": "Google"},
    )
    with urllib.request.urlopen(req, timeout=5) as response:
        return json.load(response)["access_token"]


def instance_status(worker: dict) -> str:
    url = (
        "https://compute.googleapis.com/compute/v1/projects/"
        f"{PROJECT}/zones/{worker['zone']}/instances/{worker['instance']}"
    )
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token()})
    with urllib.request.urlopen(req, timeout=20) as response:
        return json.load(response).get("status") or ""


def power(worker: dict, verb: str) -> None:
    extra = ""
    if verb == "stop" and worker.get("discard_local_ssd"):
        extra = "?discardLocalSsd=true"
    url = (
        "https://compute.googleapis.com/compute/v1/projects/"
        f"{PROJECT}/zones/{worker['zone']}/instances/{worker['instance']}/{verb}{extra}"
    )
    req = urllib.request.Request(
        url, data=b"{}", method="POST", headers={"Authorization": "Bearer " + token()}
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            response.read()
    except urllib.error.HTTPError as exc:
        if exc.code not in (400, 409):
            raise


def worker_awake(worker: dict) -> bool:
    try:
        with urllib.request.urlopen(f"http://{worker['backend']}/health", timeout=2) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError, TimeoutError):
        return False


def fleet() -> list[dict]:
    found: dict[str, bool] = {}

    def probe(key: str) -> None:
        found[key] = worker_awake(WORKERS[key])

    threads = [threading.Thread(target=probe, args=(key,)) for key in WORKERS]
    for item in threads:
        item.start()
    for item in threads:
        item.join(timeout=2.5)
    rows = []
    for key, worker in WORKERS.items():
        rows.append(
            {
                "id": key,
                "name": worker["name"],
                "kind": worker["kind"],
                "awake": bool(found.get(key)),
            }
        )
    return rows


def stop_other_gpus(worker: dict) -> None:
    """The project can run one GPU at a time. Stop the others before this one starts."""
    if worker.get("kind") != "gpu":
        return
    for other in WORKERS.values():
        if other["id"] == worker["id"] or other.get("kind") != "gpu":
            continue
        try:
            status = instance_status(other)
        except (OSError, urllib.error.URLError, json.JSONDecodeError, KeyError):
            continue
        if status in ("RUNNING", "STAGING", "PROVISIONING", "SUSPENDING", "SUSPENDED"):
            power(other, "stop")
    deadline = time.time() + 180
    while time.time() < deadline:
        busy = False
        for other in WORKERS.values():
            if other["id"] == worker["id"] or other.get("kind") != "gpu":
                continue
            try:
                status = instance_status(other)
            except (OSError, urllib.error.URLError, json.JSONDecodeError, KeyError):
                busy = True
                break
            if status in ("RUNNING", "STAGING", "PROVISIONING", "SUSPENDING", "SUSPENDED", "STOPPING"):
                busy = True
        if not busy:
            return
        time.sleep(3)


def ensure(worker: dict) -> None:
    limit = int(worker.get("wake_limit") or WAKE_LIMIT)
    with LOCKS[worker["id"]]:
        if worker.get("kind") == "gpu":
            stop_other_gpus(worker)
        deadline = time.time() + limit
        while time.time() < deadline:
            if worker_awake(worker):
                return
            try:
                verb = power_verb(instance_status(worker))
            except (OSError, urllib.error.URLError, json.JSONDecodeError, KeyError):
                verb = ""
            if verb:
                power(worker, verb)
            time.sleep(3)
    raise TimeoutError("işçi uyanmadı")


def worth_waking(path: str) -> bool:
    bare = path.split("?", 1)[0]
    if bare in {
        "/",
        "/health",
        "/panel",
        "/giris",
        "/kayit",
        "/cikis",
        "/admin",
        "/kosullar",
        "/kvkk",
        "/siparis",
        "/models",
        "/chat/completions",
    }:
        return True
    return bare.startswith(("/v1/", "/api/", "/indir/", "/static/"))


A100_TOKEN_FILE = "/etc/usta-wake/a100.token"
A100_ALLOWED_IPS = {"31.220.63.191"}


def a100_token_ok(header: str) -> bool:
    import hmac
    try:
        want = open(A100_TOKEN_FILE, encoding="utf-8").read().strip()
    except OSError:
        return False
    got = (header or "").strip()
    if not want or not got.startswith("Bearer "):
        return False
    return hmac.compare_digest(got[7:].strip().encode(), want.encode())


def a100_start_async() -> None:
    def run() -> None:
        worker = WORKERS["a100"]
        try:
            with LOCKS["a100"]:
                if power_verb(instance_status(worker)) == "start":
                    stop_other_gpus(worker)
                    power(worker, "start")
        except Exception as exc:  # noqa: BLE001
            print("a100 start failed", type(exc).__name__, flush=True)
    threading.Thread(target=run, daemon=True).start()


class Door(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def handle(self) -> None:
        try:
            super().handle()
        except (TimeoutError, OSError, urllib.error.URLError):
            try:
                self.send_error(504, "işçi uyanmadı")
            except OSError:
                return

    def do_GET(self) -> None:
        self.forward()

    def do_POST(self) -> None:
        self.forward()

    def do_HEAD(self) -> None:
        self.forward()

    def do_OPTIONS(self) -> None:
        self.forward()

    def chosen(self) -> dict:
        return WORKERS[worker_id(self.path, self.headers.get("X-Usta-Worker", ""))]

    def a100_control(self) -> bool:
        bare = self.path.split("?", 1)[0]
        if bare not in ("/a100/start", "/a100/status"):
            return False
        def reply(code: int, doc: dict) -> None:
            body = json.dumps(doc).encode() + b"\n"
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)
        if self.client_address[0] not in A100_ALLOWED_IPS or not a100_token_ok(self.headers.get("Authorization", "")):
            reply(403, {"ok": False})
            return True
        worker = WORKERS["a100"]
        if bare == "/a100/status" and self.command == "GET":
            try:
                status = instance_status(worker)
            except Exception:  # noqa: BLE001
                status = "UNKNOWN"
            reply(200, {"ok": True, "instance": status, "model_ready": status == "RUNNING" and worker_awake(worker)})
            return True
        if bare == "/a100/start" and self.command == "POST":
            length = int(self.headers.get("Content-Length", "0") or "0")
            if length:
                self.rfile.read(min(length, 4096))
            try:
                status = instance_status(worker)
            except Exception:  # noqa: BLE001
                status = "UNKNOWN"
            if power_verb(status) == "start":
                a100_start_async()
                reply(202, {"ok": True, "instance": status, "action": "start_requested"})
            else:
                reply(200, {"ok": True, "instance": status, "action": "none"})
            return True
        reply(405, {"ok": False})
        return True

    def forward(self) -> None:
        if self.a100_control():
            return
        if not worth_waking(self.path):
            self.send_error(404, "yok")
            return
        self.proxy(self.chosen())

    def proxy(self, worker: dict) -> None:
        if worker.get("kind") == "gpu":
            with GPU_LOCK:
                self._send(worker)
        else:
            self._send(worker)

    def _send(self, worker: dict) -> None:
        ensure(worker)
        length = int(self.headers.get("Content-Length", "0") or "0")
        body = self.rfile.read(length) if length else None
        headers = {key: value for key, value in self.headers.items() if key.lower() != "host"}
        headers["Host"] = worker["backend"]
        req = urllib.request.Request(
            f"http://{worker['backend']}{self.path}",
            data=body,
            headers=headers,
            method=self.command,
        )
        try:
            response = urllib.request.urlopen(req, timeout=6 * 60 * 60)
        except urllib.error.HTTPError as exc:
            response = exc
        self.close_connection = True
        self.send_response(response.status)
        for key, value in response.headers.items():
            if key.lower() in ("transfer-encoding", "connection", "keep-alive"):
                continue
            self.send_header(key, value)
        self.send_header("Connection", "close")
        self.end_headers()
        while True:
            chunk = response.read(8192)
            if not chunk:
                break
            self.wfile.write(chunk)
            self.wfile.flush()

    def log_message(self, fmt: str, *args) -> None:
        print("%s %s" % (self.address_string(), fmt % args), flush=True)


class WorkerDoor(Door):
    """Model port. A look does not wake. Model calls wake the chosen worker."""

    def forward(self) -> None:
        bare = self.path.split("?", 1)[0]
        picked = self.chosen()
        if bare == "/api/durum":
            rows = fleet()
            awake = False
            for row in rows:
                if row["id"] == picked["id"]:
                    awake = row["awake"]
            body = json.dumps(
                {
                    "ok": True,
                    "awake": awake,
                    "worker": picked["id"],
                    "port": WORKER_PORT,
                    "workers": rows,
                }
            ).encode() + b"\n"
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(body)
            return
        if bare == "/health":
            body = b'{"ok":true,"port":8788,"model":"usta"}\n'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(body)
            return
        if bare != "/api/nabiz" and not bare.startswith("/v1/") and bare not in ("/models", "/chat/completions"):
            self.send_error(404, "yok")
            return
        self.proxy(picked)


def main() -> None:
    threading.Thread(
        target=lambda: ThreadingHTTPServer(("0.0.0.0", WORKER_PORT), WorkerDoor).serve_forever(),
        daemon=True,
    ).start()
    ThreadingHTTPServer(("0.0.0.0", PORT), Door).serve_forever()


if __name__ == "__main__":
    main()
