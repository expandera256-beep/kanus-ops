+}
+
+location = /healthz {
+    client_max_body_size 4k;
+    proxy_pass http://127.0.0.1:8787;
+    proxy_set_header Host $host;
+    proxy_read_timeout 30s;
+}
+
+location = /webhooks/shopify { return 404; }
+location /webhooks/shopify/ { return 404; }
+    location = /account/login {
