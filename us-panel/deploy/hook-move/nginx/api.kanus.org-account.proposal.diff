+    proxy_buffering off;
+    proxy_cache off;
+    proxy_request_buffering on;
+    proxy_ignore_client_abort off;
+    proxy_read_timeout 2700s;
+    proxy_send_timeout 2700s;
+    send_timeout 2700s;
+}
+location = /v1/chat/completions {
+    limit_req zone=uslic_v1 burst=10 nodelay;
+    client_max_body_size 1m;
