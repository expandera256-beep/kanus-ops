# ÖNERİ — UYGULANMADI. Yalnız api.kanus.org server block.
# Kaynak: salt okunur mevcut site + prod snippet; api-test login/register/body/header düzeni.
# uslic_account_auth zone mevcut http conf içinde tanımlı (1r/s); ortak conf değişmez.
# Retry-After için upstream başlığı korunur; nginx 429 başlığı ayrıca aşağıdaki notla ele alınır.
--- /etc/nginx/sites-available/api.kanus.org
+++ /etc/nginx/sites-available/api.kanus.org (öneri)
@@ -33,7 +33,243 @@
     add_header Content-Security-Policy "frame-ancestors 'none'" always;
     add_header Referrer-Policy "no-referrer" always;
 
-    include /etc/nginx/snippets/us-license-hook-locations.conf;
+    # Prod snippet içeriği inline: başka site/snippet değişmez.
+# Prod api.kanus.org — no /account/ proxy (explicit 404). Webhooks global zone; /v1 per-IP; SSE 2700s.
+
+location = /webhooks/shopify/orders-paid {
+    limit_req zone=uslic_webhooks_global burst=80 nodelay;
+    client_max_body_size 1m;
+    proxy_pass http://127.0.0.1:8787;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_read_timeout 30s;
+}
+location = /webhooks/shopify/orders-cancelled {
+    limit_req zone=uslic_webhooks_global burst=80 nodelay;
