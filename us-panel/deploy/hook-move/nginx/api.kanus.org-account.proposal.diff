+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_http_version 1.1;
+    proxy_buffering off;
+    proxy_cache off;
+    proxy_request_buffering on;
+    proxy_ignore_client_abort off;
+    proxy_read_timeout 2700s;
