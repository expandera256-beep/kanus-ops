@@ -0,0 +1,20 @@
+//go:build !windows
+
+package i18n
+
+import (
+	"os"
+	"testing"
+)
+
+// checkPrivateFile: on Unix the mode bits are the access control.
+func checkPrivateFile(t *testing.T, path string) {
+	t.Helper()
+	fi, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fi.Mode().Perm() != 0o600 {
+		t.Errorf("perm %v", fi.Mode().Perm())
+	}
+}
diff --git a/i18n/pref_perm_windows_test.go b/i18n/pref_perm_windows_test.go
new file mode 100644
index 0000000..895cfdd
--- /dev/null
+++ b/i18n/pref_perm_windows_test.go
@@ -0,0 +1,67 @@
+//go:build windows
+
+package i18n
+
+import (
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Rights that let a principal modify, replace or re-permission the file.
+const winWriteMask = windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA | windows.FILE_WRITE_EA |
+	windows.FILE_WRITE_ATTRIBUTES | windows.DELETE | windows.WRITE_DAC | windows.WRITE_OWNER |
+	windows.GENERIC_WRITE | windows.GENERIC_ALL
+
+// checkPrivateFile: on Windows Go's FileMode only mirrors the read-only
+// attribute (always -rw-rw-rw- for writable files), so the DACL is checked:
+// owner is the current user, DACL is protected (not inherited) and
+// Everyone / Users / Authenticated Users have no write-class right.
+func checkPrivateFile(t *testing.T, path string) {
+	t.Helper()
+	sd, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT,
+		windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tu, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, _, err := sd.Owner()
+	if err != nil || !owner.Equals(tu.User.Sid) {
+		t.Errorf("owner %v, want current user %v", owner, tu.User.Sid)
+	}
+	ctl, _, err := sd.Control()
+	if err != nil || ctl&windows.SE_DACL_PROTECTED == 0 {
+		t.Errorf("DACL not protected (inherits from parent): %v", sd)
+	}
+	dacl, _, err := sd.DACL()
+	if err != nil || dacl == nil {
+		t.Fatalf("no DACL (= everyone full access): %v", err)
+	}
+	var bad []*windows.SID
+	for _, w := range []windows.WELL_KNOWN_SID_TYPE{windows.WinWorldSid, windows.WinBuiltinUsersSid, windows.WinAuthenticatedUserSid} {
+		s, err := windows.CreateWellKnownSid(w)
+		if err != nil {
+			t.Fatal(err)
+		}
+		bad = append(bad, s)
+	}
+	for i := uint32(0); i < uint32(dacl.AceCount); i++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if err := windows.GetAce(dacl, i, &ace); err != nil {
+			t.Fatal(err)
+		}
+		if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE {
+			continue
+		}
+		sid := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		for _, b := range bad {
+			if sid.Equals(b) && uint32(ace.Mask)&winWriteMask != 0 {
+				t.Errorf("write access for %v (mask %#x): %v", b, ace.Mask, sd)
+			}
+		}
+	}
+}
diff --git a/i18n/pref_security_unix_test.go b/i18n/pref_security_unix_test.go
new file mode 100644
index 0000000..0647fee
--- /dev/null
+++ b/i18n/pref_security_unix_test.go
@@ -0,0 +1,248 @@
+//go:build !windows
+
+package i18n
+
+import (
+	"errors"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func store(path string) *PrefStore {
+	return &PrefStore{Root: func() string { return filepath.Dir(path) }, Name: filepath.Base(path)}
+}
+
+// G-01: a FIFO must not block Get (nor leave the mutex held for Set).
+func TestPrefGetFIFODoesNotBlock(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "lang.json")
+	if err := syscall.Mkfifo(path, 0o600); err != nil {
+		t.Skip("mkfifo:", err)
+	}
+	t.Cleanup(func() { // unblock a stuck reader of the old implementation
+		if f, err := os.OpenFile(path, os.O_WRONLY|syscall.O_NONBLOCK, 0); err == nil {
+			f.Close()
+		}
+	})
+	p := store(path)
+	done := make(chan string, 1)
+	go func() { done <- p.Get() }()
+	select {
+	case got := <-done:
+		if got != "" {
+			t.Fatalf("FIFO must yield default, got %q", got)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("Get blocked on FIFO")
+	}
+	setDone := make(chan error, 1)
+	go func() { setDone <- store(filepath.Join(t.TempDir(), "lang.json")).Set("en") }()
+	select {
+	case <-setDone:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("Set blocked")
+	}
+}
+
+// G-01: a symlinked preference file must be ignored.
+func TestPrefGetRejectsSymlinkFile(t *testing.T) {
+	dir, out := t.TempDir(), t.TempDir()
+	target := filepath.Join(out, "target.json")
+	os.WriteFile(target, []byte(`{"lang":"en"}`), 0o600)
+	path := filepath.Join(dir, "lang.json")
+	if err := os.Symlink(target, path); err != nil {
+		t.Fatal(err)
+	}
+	if got := store(path).Get(); got != "" {
+		t.Fatalf("symlink followed: %q", got)
+	}
+}
+
+// G-01: huge (sparse) file must be rejected without reading it all.
+func TestPrefGetRejectsLargeFileQuickly(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "lang.json")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.WriteString(`{"lang":"en"}`)
+	f.Truncate(1 << 30) // 1 GiB sparse
+	f.Close()
+	start := time.Now()
+	got := store(path).Get()
+	if got != "" {
+		t.Fatalf("large file accepted: %q", got)
+	}
+	if d := time.Since(start); d > 150*time.Millisecond {
+		t.Fatalf("large file read took %v (unbounded read)", d)
+	}
+}
+
+// G-02: a symlinked parent directory must not redirect the write.
+func TestPrefSetRejectsSymlinkParent(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(root, "parent")); err != nil {
+		t.Fatal(err)
+	}
+	// root is the trusted config root; "parent" is a symlink BELOW it.
+	p := &PrefStore{Root: func() string { return root }, Name: "parent/lang.json"}
+	if err := p.Set("en"); err == nil {
+		t.Error("Set through symlinked parent succeeded")
+	}
+	if _, err := os.Lstat(filepath.Join(outside, "lang.json")); err == nil {
+		t.Fatal("write escaped to symlink target directory")
+	}
+	ents, _ := os.ReadDir(outside)
+	if len(ents) != 0 {
+		t.Fatalf("files created outside root: %v", ents)
+	}
+}
+
+// G-02: a symlinked final component must be rejected, target untouched.
+func TestPrefSetRejectsSymlinkFile(t *testing.T) {
+	dir, out := t.TempDir(), t.TempDir()
+	victim := filepath.Join(out, "victim")
+	os.WriteFile(victim, []byte("keep"), 0o600)
+	path := filepath.Join(dir, "lang.json")
+	os.Symlink(victim, path)
+	if err := store(path).Set("en"); err == nil {
+		t.Error("Set over symlink succeeded")
+	}
+	if b, _ := os.ReadFile(victim); string(b) != "keep" {
+		t.Fatal("victim modified")
+	}
+}
+
+// Regression: normal write stays inside its directory, 0600, round-trips.
+func TestPrefSetStaysInsideRoot(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "us", "lang.json")
+	p := store(path)
+	if err := p.Set("en"); err != nil {
+		t.Fatal(err)
+	}
+	if p.Get() != "en" {
+		t.Fatal("roundtrip")
+	}
+	fi, err := os.Lstat(path)
+	if err != nil || !fi.Mode().IsRegular() || fi.Mode().Perm() != 0o600 {
+		t.Fatalf("bad file %v %v", fi, err)
+	}
+	ents, _ := os.ReadDir(filepath.Dir(path))
+	if len(ents) != 1 {
+		t.Fatalf("temp files left: %v", ents)
+	}
+}
+
+// R2-01: a legitimately symlinked config root (/home -> /var/home) works.
+func TestPrefSymlinkedRootPersists(t *testing.T) {
+	base := t.TempDir()
+	os.MkdirAll(filepath.Join(base, "var", "home", "u", ".config", "us"), 0o700)
+	if err := os.Symlink(filepath.Join(base, "var", "home"), filepath.Join(base, "home")); err != nil {
+		t.Fatal(err)
+	}
+	root := filepath.Join(base, "home", "u", ".config", "us")
+	p := &PrefStore{Root: func() string { return root }, Name: "lang.json"}
+	if err := p.Set("en"); err != nil {
+		t.Fatalf("save through symlinked root failed: %v", err)
+	}
+	if p.Get() != "en" {
+		t.Fatal("not read back")
+	}
+	q := &PrefStore{Root: func() string { return root }, Name: "lang.json"} // new process
+	if q.Get() != "en" {
+		t.Fatal("not persisted")
+	}
+	if _, err := os.Lstat(filepath.Join(base, "var", "home", "u", ".config", "us", "lang.json")); err != nil {
+		t.Fatal("file not in resolved root:", err)
+	}
+}
+
+// R2-01: symlinks BELOW the (symlinked) root stay rejected.
+func TestPrefSymlinkBelowSymlinkedRootRejected(t *testing.T) {
+	base, outside := t.TempDir(), t.TempDir()
+	os.MkdirAll(filepath.Join(base, "real"), 0o700)
+	os.Symlink(filepath.Join(base, "real"), filepath.Join(base, "cfg"))
+	os.Symlink(outside, filepath.Join(base, "real", "sub"))
+	p := &PrefStore{Root: func() string { return filepath.Join(base, "cfg") }, Name: "sub/lang.json"}
+	if err := p.Set("en"); err == nil {
+		t.Fatal("symlink below root accepted")
+	}
+	os.Symlink(filepath.Join(outside, "x.json"), filepath.Join(base, "real", "lang.json"))
+	p2 := &PrefStore{Root: func() string { return filepath.Join(base, "cfg") }, Name: "lang.json"}
+	if err := p2.Set("en"); err == nil {
+		t.Fatal("symlinked file below root accepted")
+	}
+	if ents, _ := os.ReadDir(outside); len(ents) != 0 {
+		t.Fatalf("wrote outside: %v", ents)
+	}
+}
+
+// R2-01: re-pointing the root symlink after first use must not move writes
+// (the root is pinned as a directory fd).
+func TestPrefRootRebindPinned(t *testing.T) {
+	base := t.TempDir()
+	a, b := filepath.Join(base, "a"), filepath.Join(base, "b")
+	os.MkdirAll(a, 0o700)
+	os.MkdirAll(b, 0o700)
+	link := filepath.Join(base, "cfg")
+	os.Symlink(a, link)
+	p := &PrefStore{Root: func() string { return link }, Name: "lang.json"}
+	if err := p.Set("en"); err != nil {
+		t.Fatal(err)
+	}
+	os.Remove(link)
+	os.Symlink(b, link)
+	if err := p.Set("tr"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(b, "lang.json")); err == nil {
+		t.Fatal("write followed rebound root")
+	}
+	if raw, _ := os.ReadFile(filepath.Join(a, "lang.json")); string(raw) != `{"lang":"tr"}` {
+		t.Fatalf("pinned root not updated: %q", raw)
+	}
+}
+
+// R2-01: an unopenable root keeps the choice in memory, Set reports it.
+func TestPrefUnavailableRootMemoryOnly(t *testing.T) {
+	f := filepath.Join(t.TempDir(), "file")
+	os.WriteFile(f, []byte("x"), 0o600)
+	p := &PrefStore{Root: func() string { return filepath.Join(f, "sub") }, Name: "lang.json"} // parent is a file
+	err := p.Set("en")
+	if !errors.Is(err, ErrNotPersisted) {
+		t.Fatalf("want ErrNotPersisted, got %v", err)
+	}
+	if p.Get() != "en" {
+		t.Fatal("memory fallback missing")
+	}
+}
+
+// R2-01 HTTP: symlinked root -> 200 and persisted; unavailable root -> 503.
+func TestPrefHandlerSymlinkedRootAndUnavailable(t *testing.T) {
+	base := t.TempDir()
+	os.MkdirAll(filepath.Join(base, "var", "home"), 0o700)
+	os.Symlink(filepath.Join(base, "var", "home"), filepath.Join(base, "home"))
+	ok := &PrefStore{Root: func() string { return filepath.Join(base, "home") }, Name: "lang.json"}
+	post := func(p *PrefStore) int {
+		r := httptest.NewRequest("POST", "/api/lang", strings.NewReader(`{"lang":"en"}`))
+		r.Header.Set("Content-Type", "application/json")
+		w := httptest.NewRecorder()
+		PrefHandler(p, nil).ServeHTTP(w, r)
+		return w.Code
+	}
+	if c := post(ok); c != 200 || ok.Get() != "en" {
+		t.Fatalf("symlinked root: %d %q", c, ok.Get())
+	}
+	f := filepath.Join(base, "file")
+	os.WriteFile(f, nil, 0o600)
+	bad := &PrefStore{Root: func() string { return filepath.Join(f, "x") }, Name: "lang.json"}
+	if c := post(bad); c != 503 {
+		t.Fatalf("unavailable root status %d", c)
+	}
+}
diff --git a/i18n/pref_test.go b/i18n/pref_test.go
new file mode 100644
index 0000000..1bc64a7
--- /dev/null
+++ b/i18n/pref_test.go
@@ -0,0 +1,87 @@
+package i18n
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPrefStoreRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "sub", "lang.json")
+	p := &PrefStore{Root: func() string { return filepath.Dir(path) }, Name: filepath.Base(path)}
+	if p.Get() != "" {
+		t.Fatal("empty store should return empty")
+	}
+	if err := p.Set("EN-gb"); err != nil {
+		t.Fatal(err)
+	}
+	if p.Get() != "en" {
+		t.Fatal("got", p.Get())
+	}
+	checkPrivateFile(t, path)
+	if err := p.Set("xx"); err != ErrUnsupported {
+		t.Fatal("unsupported accepted", err)
+	}
+	if p.Get() != "en" {
+		t.Fatal("bad set changed value")
+	}
+	os.WriteFile(path, []byte(`{"lang":"zz"}`), 0o600)
+	if p.Get() != "" {
+		t.Fatal("unknown stored lang must be ignored")
+	}
+	os.WriteFile(path, []byte(`garbage`), 0o600)
+	if p.Get() != "" {
+		t.Fatal("corrupt file must be ignored")
+	}
+	var nilStore *PrefStore
+	if nilStore.Get() != "" {
+		t.Fatal("nil store")
+	}
+}
+
+func TestPrefHandler(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "lang.json")
+	p := &PrefStore{Root: func() string { return filepath.Dir(path) }, Name: filepath.Base(path)}
+	h := PrefHandler(p, nil)
+	do := func(method, ct, body string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, "/api/lang", strings.NewReader(body))
+		if ct != "" {
+			r.Header.Set("Content-Type", ct)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		return w
+	}
+	if w := do("GET", "", ""); !strings.Contains(w.Body.String(), `"tr"`) {
+		t.Fatal("default must be tr:", w.Body.String())
+	}
+	if w := do("POST", "application/x-www-form-urlencoded", "lang=en"); w.Code != http.StatusUnsupportedMediaType {
+		t.Fatal("form post accepted", w.Code)
+	}
+	if w := do("POST", "application/json", `{"lang":"de"}`); w.Code != http.StatusBadRequest {
+		t.Fatal("unsupported lang accepted", w.Code)
+	}
+	if w := do("POST", "application/json", `{`); w.Code != http.StatusBadRequest {
+		t.Fatal("bad json", w.Code)
+	}
+	if w := do("POST", "application/json; charset=utf-8", `{"lang":"en"}`); w.Code != 200 {
+		t.Fatal("valid post", w.Code)
+	}
+	if w := do("GET", "", ""); !strings.Contains(w.Body.String(), `"en"`) {
+		t.Fatal("persisted value", w.Body.String())
+	}
+	if w := do("DELETE", "", ""); w.Code != http.StatusMethodNotAllowed {
+		t.Fatal(w.Code)
+	}
+	// Handler honours stored preference when no lang query is given.
+	r := httptest.NewRequest("GET", "/api/i18n", nil)
+	w := httptest.NewRecorder()
+	Handler(p.Get).ServeHTTP(w, r)
+	if !strings.Contains(w.Body.String(), `"lang":"en"`) {
+		t.Fatal("handler ignored preference")
+	}
+}
diff --git a/i18n/pref_unix.go b/i18n/pref_unix.go
new file mode 100644
index 0000000..b93e462
--- /dev/null
+++ b/i18n/pref_unix.go
@@ -0,0 +1,113 @@
+//go:build !windows
+
+package i18n
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+type rootHandle = int
+
+// openRoot pins the already-resolved trusted root as a directory fd.
+func openRoot(resolved string) (rootHandle, error) {
+	return unix.Open(resolved, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+}
+
+// walkBelow opens the intermediate directories of parts below root with
+// openat(O_NOFOLLOW|O_DIRECTORY); a symlink below the root is rejected.
+// The returned fd must be closed by the caller unless it equals root.
+func walkBelow(root rootHandle, parts []string, create bool) (int, error) {
+	fd := root
+	for _, part := range parts[:len(parts)-1] {
+		next, err := unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if errors.Is(err, unix.ENOENT) && create {
+			if merr := unix.Mkdirat(fd, part, 0o700); merr != nil && !errors.Is(merr, unix.EEXIST) {
+				closeBelow(root, fd)
+				return -1, merr
+			}
+			next, err = unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		}
+		closeBelow(root, fd)
+		if err != nil {
+			if errors.Is(err, unix.ELOOP) || errors.Is(err, unix.ENOTDIR) {
+				return -1, errUnsafePath
+			}
+			return -1, err
+		}
+		fd = next
+	}
+	return fd, nil
+}
+
+func closeBelow(root rootHandle, fd int) {
+	if fd != root && fd >= 0 {
+		unix.Close(fd)
+	}
+}
+
+func readPrefFile(root rootHandle, parts []string) ([]byte, error) {
+	dirfd, err := walkBelow(root, parts, false)
+	if err != nil {
+		return nil, err
+	}
+	defer closeBelow(root, dirfd)
+	base := parts[len(parts)-1]
+	fd, err := unix.Openat(dirfd, base, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), base)
+	defer f.Close()
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return nil, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG || st.Size > maxPrefSize {
+		return nil, errUnsafePath
+	}
+	return readLimited(f)
+}
+
+func writePrefFile(root rootHandle, parts []string, raw []byte) error {
+	dirfd, err := walkBelow(root, parts, true)
+	if err != nil {
+		return err
+	}
+	defer closeBelow(root, dirfd)
+	base := parts[len(parts)-1]
+	var st unix.Stat_t
+	if err := unix.Fstatat(dirfd, base, &st, unix.AT_SYMLINK_NOFOLLOW); err == nil && st.Mode&unix.S_IFMT != unix.S_IFREG {
+		return errUnsafePath
+	}
+	var rnd [8]byte
+	if _, err := rand.Read(rnd[:]); err != nil {
+		return err
+	}
+	tmp := ".lang-" + hex.EncodeToString(rnd[:]) + ".tmp"
+	fd, err := unix.Openat(dirfd, tmp, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0o600)
+	if err != nil {
+		return err
+	}
+	f := os.NewFile(uintptr(fd), tmp)
+	_, err = f.Write(raw)
+	if err == nil {
+		err = f.Sync()
+	}
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	if err == nil {
+		err = unix.Renameat(dirfd, tmp, dirfd, base)
+	}
+	if err != nil {
+		_ = unix.Unlinkat(dirfd, tmp, 0)
+		return err
+	}
+	_ = unix.Fsync(dirfd)
+	return nil
+}
diff --git a/i18n/pref_windows.go b/i18n/pref_windows.go
new file mode 100644
index 0000000..3242f30
--- /dev/null
+++ b/i18n/pref_windows.go
@@ -0,0 +1,239 @@
+//go:build windows
+
+package i18n
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"os"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type rootHandle = windows.Handle
+
+// Directory/file access rights (winnt.h).
+const (
+	fileListDirectory   = 0x0001
+	fileAddFile         = 0x0002
+	fileAddSubdirectory = 0x0004
+	fileTraverse        = 0x0020
+	fileReadAttributes  = 0x0080
+	dirAccess           = fileListDirectory | fileTraverse | fileAddFile | fileAddSubdirectory | fileReadAttributes
+)
+
+const shareAll = windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE | windows.FILE_SHARE_DELETE
+
+// ntOpen opens name relative to dir (or an absolute NT path when dir is 0)
+// with NtCreateFile. FILE_OPEN_REPARSE_POINT makes the open land on a
+// symlink/junction itself instead of its target, so the handle can be
+// verified with GetFileInformationByHandle before any data is used.
+func ntOpen(dir windows.Handle, name string, access, disposition, options uint32) (windows.Handle, error) {
+	return ntOpenSD(dir, name, access, disposition, options, nil)
+}
+
+// ntOpenSD is ntOpen with a security descriptor that is applied only when
+// the object is newly created (FILE_CREATE / FILE_OPEN_IF creating).
+func ntOpenSD(dir windows.Handle, name string, access, disposition, options uint32, sd *windows.SECURITY_DESCRIPTOR) (windows.Handle, error) {
+	uname, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, err
+	}
+	oa := &windows.OBJECT_ATTRIBUTES{RootDirectory: dir, ObjectName: uname, Attributes: windows.OBJ_CASE_INSENSITIVE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(*oa))
+	var iosb windows.IO_STATUS_BLOCK
+	var h windows.Handle
+	err = windows.NtCreateFile(&h, access|windows.SYNCHRONIZE, oa, &iosb, nil, windows.FILE_ATTRIBUTE_NORMAL, shareAll,
+		disposition, options|windows.FILE_SYNCHRONOUS_IO_NONALERT|windows.FILE_OPEN_REPARSE_POINT, 0, 0)
+	if err != nil {
+		return 0, err
+	}
+	return h, nil
+}
+
+// privateSD returns a protected security descriptor (inheritance from the
+// parent disabled) owned by the current user that grants full access only
+// to the current user, SYSTEM and Administrators. It is set atomically at
+// creation time through OBJECT_ATTRIBUTES, so a config root outside the
+// profile (e.g. a shared folder that grants Users/Everyone write) cannot
+// make lang.json or the directories we create writable by others. dir
+// adds OI|CI so files created inside also get the private ACL.
+func privateSD(dir bool) (*windows.SECURITY_DESCRIPTOR, error) {
+	tu, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		return nil, err
+	}
+	sid := tu.User.Sid.String()
+	inh := ""
+	if dir {
+		inh = "OICI"
+	}
+	return windows.SecurityDescriptorFromString("O:" + sid + "D:P(A;" + inh + ";FA;;;" + sid + ")(A;" + inh + ";FA;;;SY)(A;" + inh + ";FA;;;BA)")
+}
+
+// verify checks the opened handle (not a path): no reparse point, and the
+// expected kind (directory or regular file).
+func verify(h windows.Handle, wantDir bool) (*windows.ByHandleFileInformation, error) {
+	var info windows.ByHandleFileInformation
+	if err := windows.GetFileInformationByHandle(h, &info); err != nil {
+		return nil, err
+	}
+	isDir := info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0
+	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || isDir != wantDir {
+		return nil, errUnsafePath
+	}
+	return &info, nil
+}
+
+// openRoot pins the already-resolved trusted root as a directory handle.
+func openRoot(resolved string) (rootHandle, error) {
+	h, err := ntOpen(0, `\??\`+resolved, dirAccess, windows.FILE_OPEN, windows.FILE_DIRECTORY_FILE)
+	if err != nil {
+		return 0, err
+	}
+	if _, err := verify(h, true); err != nil {
+		windows.CloseHandle(h)
+		return 0, err
+	}
+	return h, nil
+}
+
+func closeBelow(root rootHandle, h windows.Handle) {
+	if h != root && h != 0 {
+		windows.CloseHandle(h)
+	}
+}
+
+func walkBelow(root rootHandle, parts []string, create bool) (windows.Handle, error) {
+	h := root
+	disp := uint32(windows.FILE_OPEN)
+	var sd *windows.SECURITY_DESCRIPTOR
+	if create {
+		disp = windows.FILE_OPEN_IF
+		var err error
+		if sd, err = privateSD(true); err != nil {
+			return 0, err
+		}
+	}
+	for _, part := range parts[:len(parts)-1] {
+		next, err := ntOpenSD(h, part, dirAccess, disp, windows.FILE_DIRECTORY_FILE, sd)
+		closeBelow(root, h)
+		if err != nil {
+			return 0, err
+		}
+		if _, err := verify(next, true); err != nil {
+			windows.CloseHandle(next)
+			return 0, err
+		}
+		h = next
+	}
+	return h, nil
+}
+
+func readPrefFile(root rootHandle, parts []string) ([]byte, error) {
+	dir, err := walkBelow(root, parts, false)
+	if err != nil {
+		return nil, err
+	}
+	defer closeBelow(root, dir)
+	h, err := ntOpen(dir, parts[len(parts)-1], windows.FILE_GENERIC_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(h), parts[len(parts)-1])
+	defer f.Close()
+	info, err := verify(h, false)
+	if err != nil {
+		return nil, err
+	}
+	// A hard link (no privilege needed on NTFS) could alias a file outside
+	// the root; only a single-link file is trusted on read. Set replaces
+	// the directory entry by rename, so the aliased file is never written.
+	if info.NumberOfLinks != 1 || info.FileSizeHigh != 0 || info.FileSizeLow > maxPrefSize {
+		return nil, errUnsafePath
+	}
+	return readLimited(f)
+}
+
+type fileRenameInformation struct {
+	ReplaceIfExists uint32
+	RootDirectory   windows.Handle
+	FileNameLength  uint32
+	FileName        [1]uint16
+}
+
+// renameByHandle renames the open file h to name inside dir, relative to
+// the dir handle (NtSetInformationFile/FileRenameInformation), replacing a
+// regular file atomically.
+func renameByHandle(h, dir windows.Handle, name string) error {
+	u16, err := windows.UTF16FromString(name)
+	if err != nil {
+		return err
+	}
+	n := len(u16) - 1
+	var probe fileRenameInformation
+	size := int(unsafe.Offsetof(probe.FileName)) + n*2
+	if size < int(unsafe.Sizeof(probe)) {
+		size = int(unsafe.Sizeof(probe))
+	}
+	buf := make([]byte, size)
+	ri := (*fileRenameInformation)(unsafe.Pointer(&buf[0]))
+	ri.ReplaceIfExists = 1
+	ri.RootDirectory = dir
+	ri.FileNameLength = uint32(n * 2)
+	copy(unsafe.Slice(&ri.FileName[0], n), u16[:n])
+	var iosb windows.IO_STATUS_BLOCK
+	return windows.NtSetInformationFile(h, &iosb, &buf[0], uint32(size), windows.FileRenameInformation)
+}
+
+func deleteByHandle(h windows.Handle) {
+	var del uint8 = 1
+	_ = windows.SetFileInformationByHandle(h, windows.FileDispositionInfo, &del, 1)
+}
+
+func writePrefFile(root rootHandle, parts []string, raw []byte) error {
+	dir, err := walkBelow(root, parts, true)
+	if err != nil {
+		return err
+	}
+	defer closeBelow(root, dir)
+	base := parts[len(parts)-1]
+	// An existing target must be a regular file (checked on its handle).
+	if old, err := ntOpen(dir, base, fileReadAttributes, windows.FILE_OPEN, 0); err == nil {
+		_, verr := verify(old, false)
+		windows.CloseHandle(old)
+		if verr != nil {
+			return verr
+		}
+	}
+	var rnd [8]byte
+	if _, err := rand.Read(rnd[:]); err != nil {
+		return err
+	}
+	tmp := ".lang-" + hex.EncodeToString(rnd[:]) + ".tmp"
+	sd, err := privateSD(false)
+	if err != nil {
+		return err
+	}
+	h, err := ntOpenSD(dir, tmp, windows.FILE_GENERIC_WRITE|windows.DELETE|fileReadAttributes, windows.FILE_CREATE, windows.FILE_NON_DIRECTORY_FILE, sd)
+	if err != nil {
+		return err
+	}
+	defer windows.CloseHandle(h)
+	var done uint32
+	err = windows.WriteFile(h, raw, &done, nil)
+	if err == nil && int(done) != len(raw) {
+		err = errUnsafePath
+	}
+	if err == nil {
+		err = windows.FlushFileBuffers(h)
+	}
+	if err == nil {
+		err = renameByHandle(h, dir, base)
+	}
+	if err != nil {
+		deleteByHandle(h)
+	}
+	return err
+}
diff --git a/i18n/pref_windows_test.go b/i18n/pref_windows_test.go
new file mode 100644
index 0000000..e811a2e
--- /dev/null
+++ b/i18n/pref_windows_test.go
@@ -0,0 +1,147 @@
+//go:build windows
+
+package i18n
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func winStore(root, name string) *PrefStore {
+	return &PrefStore{Root: func() string { return root }, Name: name}
+}
+
+// junction creates a directory junction (no admin rights needed).
+func junction(t *testing.T, link, target string) {
+	t.Helper()
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J", link, target).CombinedOutput(); err != nil {
+		t.Skipf("mklink /J unavailable: %v %s", err, out)
+	}
+}
+
+func TestWinPrefNormalSave(t *testing.T) {
+	root := t.TempDir()
+	p := winStore(root, "lang.json")
+	if err := p.Set("en"); err != nil {
+		t.Fatal(err)
+	}
+	if winStore(root, "lang.json").Get() != "en" {
+		t.Fatal("not persisted")
+	}
+	ents, _ := os.ReadDir(root)
+	if len(ents) != 1 {
+		t.Fatalf("temp files left: %v", ents)
+	}
+}
+
+func TestWinPrefJunctionBelowRootRejected(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	junction(t, filepath.Join(root, "sub"), outside)
+	if err := winStore(root, "sub/lang.json").Set("en"); err == nil {
+		t.Fatal("junction below root accepted")
+	}
+	if winStore(root, "sub/lang.json").Get() != "" {
+		t.Fatal("read through junction")
+	}
+	if ents, _ := os.ReadDir(outside); len(ents) != 0 {
+		t.Fatalf("wrote outside root: %v", ents)
+	}
+}
+
+func TestWinPrefSymlinkFileRejected(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	victim := filepath.Join(outside, "victim.json")
+	os.WriteFile(victim, []byte(`{"lang":"en"}`), 0o600)
+	if err := os.Symlink(victim, filepath.Join(root, "lang.json")); err != nil {
+		t.Skip("symlink privilege missing:", err)
+	}
+	if winStore(root, "lang.json").Get() != "" {
+		t.Fatal("symlink followed on read")
+	}
+	if err := winStore(root, "lang.json").Set("tr"); err == nil {
+		t.Fatal("symlink replaced/followed on write")
+	}
+	if b, _ := os.ReadFile(victim); string(b) != `{"lang":"en"}` {
+		t.Fatal("victim modified")
+	}
+}
+
+func TestWinPrefJunctionRootAllowedAndPinned(t *testing.T) {
+	base := t.TempDir()
+	a, b := filepath.Join(base, "a"), filepath.Join(base, "b")
+	os.MkdirAll(a, 0o700)
+	os.MkdirAll(b, 0o700)
+	link := filepath.Join(base, "cfg")
+	junction(t, link, a)
+	p := winStore(link, "lang.json")
+	if err := p.Set("en"); err != nil {
+		t.Fatalf("junctioned root rejected: %v", err)
+	}
+	os.Remove(link)
+	junction(t, link, b)
+	if err := p.Set("tr"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(b, "lang.json")); err == nil {
+		t.Fatal("write followed re-pointed root")
+	}
+}
+
+// TestWinPrefDACLSharedRoot simulates a config root outside the profile
+// (US_DESK=C:\ShareDir) whose inherited ACL grants Everyone full access:
+// lang.json and created subdirectories must still get the private DACL.
+func TestWinPrefDACLSharedRoot(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "share")
+	sd, err := windows.SecurityDescriptorFromString("D:(A;OICI;FA;;;WD)(A;OICI;FA;;;BU)(A;OICI;FA;;;AU)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sa := &windows.SecurityAttributes{Length: uint32(unsafe.Sizeof(windows.SecurityAttributes{})), SecurityDescriptor: sd}
+	rp, _ := windows.UTF16PtrFromString(root)
+	if err := windows.CreateDirectory(rp, sa); err != nil {
+		t.Fatal(err)
+	}
+	if err := winStore(root, "lang.json").Set("en"); err != nil {
+		t.Fatal(err)
+	}
+	checkPrivateFile(t, filepath.Join(root, "lang.json"))
+	if err := winStore(root, "sub/lang.json").Set("en"); err != nil {
+		t.Fatal(err)
+	}
+	checkPrivateFile(t, filepath.Join(root, "sub"))
+	checkPrivateFile(t, filepath.Join(root, "sub", "lang.json"))
+	if err := winStore(root, "lang.json").Set("tr"); err != nil {
+		t.Fatal(err)
+	}
+	checkPrivateFile(t, filepath.Join(root, "lang.json"))
+}
+
+// TestWinPrefHardlinkAliasRejected is the no-privilege counterpart of the
+// symlink case: a hard link (CreateHardLink needs no special right) from
+// lang.json to a file outside the root is not trusted on read, and Set
+// replaces the entry instead of writing through to the outside file.
+func TestWinPrefHardlinkAliasRejected(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	victim := filepath.Join(outside, "victim.json")
+	os.WriteFile(victim, []byte(`{"lang":"en"}`), 0o600)
+	if err := os.Link(victim, filepath.Join(root, "lang.json")); err != nil {
+		t.Fatalf("hard link creation failed (no privilege needed on NTFS): %v", err)
+	}
+	if winStore(root, "lang.json").Get() != "" {
+		t.Fatal("hard-linked alias trusted on read")
+	}
+	if err := winStore(root, "lang.json").Set("tr"); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(victim); string(b) != `{"lang":"en"}` {
+		t.Fatal("victim modified through hard link")
+	}
+	if winStore(root, "lang.json").Get() != "tr" {
+		t.Fatal("replacement not stored")
+	}
+}
