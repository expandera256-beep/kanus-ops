+	// Self-signed test certificate with the production client: rejected
+	// even when its SPKI is pinned (chain verification comes first).
+	srv := httptest.NewTLSServer(http.HandlerFunc(serve(fxBody)))
+	defer srv.Close()
+	oldPins := fxPinsSPKI
+	fxPinsSPKI = "sha256/" + spkiPin(srv.Certificate())
+	defer func() { fxPinsSPKI = oldPins }()
+	if _, _, _, err := fetchFX(srv.URL); err == nil || !strings.Contains(err.Error(), "certificate") {
+		t.Fatal("untrusted certificate accepted", err)
