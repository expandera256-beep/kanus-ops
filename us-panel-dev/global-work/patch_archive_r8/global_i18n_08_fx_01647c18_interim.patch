+	// Plain HTTP gateway: refused before any request.
+	var hits atomic.Int64
+	plain := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits.Add(1); serve(fxBody)(w, r) }))
