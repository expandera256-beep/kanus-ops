+func TestFXTLSAndTransportPolicy(t *testing.T) {
+	fxReset(t)
+	if c := fxTransport().TLSClientConfig; c == nil || c.InsecureSkipVerify || c.MinVersion < tls.VersionTLS12 || c.VerifyConnection == nil {
+		t.Fatal("TLS config must verify certificates", c)
