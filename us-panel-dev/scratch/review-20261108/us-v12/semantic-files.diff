+// modelSpendable is the read-only entitlement gate that runs after the
+// credential check and BEFORE any GPU readiness probe or wake: the
+// credential must resolve to an active license (account sessions: one the
+// account owns) with usable credit, i.e. credits minus live reservations > 0.
+// ErrInvalid → 403 (raw key without an active license), ErrNoCredit → 402
+// (no usable credit; for sessions also no owned active license). It never mutates
+// the store; expired reservations are simply not counted.
+func (s *Store) modelSpendable(token string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if strings.HasPrefix(token, "usa1.") {
+		a := s.accountForTokenLocked(token, now)
+		if a == nil {
+			return ErrInvalid
+		}
+		// No owned active license, or none with usable credit: 402, the same
+		// status the reservation path has always returned for sessions.
+		for key, owner := range s.st.LicenseOwners {
+			if l := s.st.Licenses[key]; owner == a.ID && l != nil && !l.Revoked && now.Before(l.ExpiresAt) && s.usableCreditLocked(key, l, now) > 0 {
+				return nil
+			}
+		}
+		return ErrNoCredit
+	}
+	l := s.st.Licenses[token]
+	if l == nil || l.Revoked || !now.Before(l.ExpiresAt) || l.Plan.Kind != "use" && l.Plan.Kind != "sub" {
+		return ErrInvalid
+	}
+	if s.usableCreditLocked(token, l, now) <= 0 {
+		return ErrNoCredit
+	}
+	return nil
+}
+
+func (s *Store) usableCreditLocked(key string, l *License, now time.Time) int {
+	if x := s.legacySecondsLocked(key, l); x > 0 {
+		return x
+	}
+	reserved := l.Reserved
+	for _, r := range s.st.Reservations {
+		if r != nil && r.Key == key && !now.Before(r.Expires) {
+			reserved -= r.Amount // expired, released on the next reserve
+		}
+	}
+	if reserved < 0 {
+		reserved = 0
+	}
+	return l.Credits - reserved
+}
