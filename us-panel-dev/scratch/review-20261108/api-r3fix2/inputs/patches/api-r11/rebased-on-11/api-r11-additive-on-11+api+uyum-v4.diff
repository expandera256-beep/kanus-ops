diff -ruN pre/apiv1/errors.go st/apiv1/errors.go
--- a/apiv1/errors.go	1970-01-01 02:00:00.000000000 +0200
+++ b/apiv1/errors.go	2026-11-08 00:46:17.335457166 +0300
@@ -0,0 +1,57 @@
+package apiv1
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"strings"
+)
+
+type ErrorBody struct {
+	Error     string `json:"error"`
+	Code      string `json:"code"`
+	Message   string `json:"message"`
+	RequestID string `json:"request_id"`
+}
+
+func newRequestID() string {
+	b := make([]byte, 8)
+	if _, err := rand.Read(b); err != nil {
+		return "0000000000000000"
+	}
+	return hex.EncodeToString(b)
+}
+
+func wantsEnvelope(r *http.Request) bool {
+	if r == nil {
+		return false
+	}
+	if strings.EqualFold(r.Header.Get("X-Kanus-Error-Envelope"), "1") {
+		return true
+	}
+	if r.URL != nil && r.URL.Query().Get("error_envelope") == "1" {
+		return true
+	}
+	a := r.Header.Get("Accept")
+	return strings.Contains(a, "application/json") || strings.Contains(a, "application/problem+json")
+}
+
+func WriteAPIError(w http.ResponseWriter, r *http.Request, status int, code, message string) {
+	if message == "" {
+		message = http.StatusText(status)
+	}
+	if code == "" {
+		code = "request_rejected"
+	}
+	rid := newRequestID()
+	w.Header().Set("X-Request-Id", rid)
+	if wantsEnvelope(r) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		w.WriteHeader(status)
+		_ = json.NewEncoder(w).Encode(ErrorBody{Error: message, Code: code, Message: message, RequestID: rid})
+		return
+	}
+	http.Error(w, message, status)
+}
diff -ruN pre/apiv1/version.go st/apiv1/version.go
--- a/apiv1/version.go	1970-01-01 02:00:00.000000000 +0200
+++ b/apiv1/version.go	2026-11-08 00:46:17.335457166 +0300
@@ -0,0 +1,26 @@
+package apiv1
+
+import (
+	"net/http"
+	"strings"
+)
+
+const APIVersion = "1"
+
+func WithAPIVersion(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("API-Version", APIVersion)
+		next.ServeHTTP(w, r)
+	})
+}
+
+// MountAccountAlias rewrites /v1/account/* → /account/* without replacing legacy routes.
+func MountAccountAlias(mux *http.ServeMux, accounts http.Handler) {
+	mux.Handle("/v1/account/", WithAPIVersion(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		r2 := r.Clone(r.Context())
+		u := *r.URL
+		u.Path = strings.TrimPrefix(r.URL.Path, "/v1")
+		r2.URL = &u
+		accounts.ServeHTTP(w, r2)
+	})))
+}
diff -ruN pre/apiv1/version_test.go st/apiv1/version_test.go
--- a/apiv1/version_test.go	1970-01-01 02:00:00.000000000 +0200
+++ b/apiv1/version_test.go	2026-11-08 00:46:17.335457166 +0300
@@ -0,0 +1,32 @@
+package apiv1
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestWithAPIVersionHeader(t *testing.T) {
+	h := WithAPIVersion(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, httptest.NewRequest("GET", "/v1/x", nil))
+	if w.Header().Get("API-Version") != "1" {
+		t.Fatal(w.Header().Get("API-Version"))
+	}
+}
+
+func TestMountAccountAlias(t *testing.T) {
+	mux := http.NewServeMux()
+	var saw string
+	accounts := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		saw = r.URL.Path
+		w.WriteHeader(200)
+	})
+	mux.Handle("/account/", accounts)
+	MountAccountAlias(mux, accounts)
+	w := httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("POST", "/v1/account/login", nil))
+	if w.Code != 200 || saw != "/account/login" || w.Header().Get("API-Version") != "1" {
+		t.Fatal(w.Code, saw, w.Header().Get("API-Version"))
+	}
+}
