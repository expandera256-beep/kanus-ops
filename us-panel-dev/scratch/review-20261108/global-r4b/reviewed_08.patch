--- a/i18n/fx.go
+++ b/i18n/fx.go
@@ -0,0 +1,95 @@
+package i18n
+
+// Approximate foreign-currency display next to TRY prices (display only).
+// Payments and the ledger stay TRY; nothing here feeds a charge or credit.
+// Input is a kanus.fx/1 snapshot built from TCMB today.xml ForexSelling.
+
+import (
+	"encoding/json"
+	"errors"
+	"math"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// FXMaxAge: older snapshots are ignored (weekends + bank holidays).
+const FXMaxAge = 5 * 24 * time.Hour
+
+// FXSnapshot holds TRY per 1 EUR / 1 USD on the TCMB bulletin date.
+type FXSnapshot struct {
+	Date     time.Time
+	EUR, USD float64
+}
+
+var fxDateRe = regexp.MustCompile(`^\d{4}-\d\d-\d\d$`)
+
+// ParseFX validates a kanus.fx/1 document. Any problem returns an error and
+// callers must then show TRY only.
+func ParseFX(raw []byte, now time.Time) (FXSnapshot, error) {
+	var z FXSnapshot
+	if len(raw) == 0 || len(raw) > 4096 {
+		return z, errors.New("fx: size")
+	}
+	var d struct {
+		Schema string                     `json:"schema"`
+		Base   string                     `json:"base"`
+		Date   string                     `json:"date"`
+		Rates  map[string]json.RawMessage `json:"rates"`
+	}
+	if err := json.Unmarshal(raw, &d); err != nil {
+		return z, errors.New("fx: json")
+	}
+	if d.Schema != "kanus.fx/1" || d.Base != "TRY" || !fxDateRe.MatchString(d.Date) || len(d.Rates) != 2 {
+		return z, errors.New("fx: schema")
+	}
+	t, err := time.Parse("2006-01-02", d.Date)
+	if err != nil {
+		return z, errors.New("fx: date")
+	}
+	if age := now.Sub(t); age < -36*time.Hour || age > FXMaxAge+24*time.Hour {
+		return z, errors.New("fx: stale")
+	}
+	rate := func(k string) (float64, error) {
+		var v float64
+		r, ok := d.Rates[k]
+		if !ok || len(r) == 0 || r[0] == '"' || json.Unmarshal(r, &v) != nil || math.IsNaN(v) || v < 1 || v > 1000 {
+			return 0, errors.New("fx: rate " + k)
+		}
+		return v, nil
+	}
+	eur, err := rate("EUR")
+	if err != nil {
+		return z, err
+	}
+	usd, err := rate("USD")
+	if err != nil {
+		return z, err
+	}
+	if x := eur / usd; x < 0.8 || x > 1.6 {
+		return z, errors.New("fx: cross")
+	}
+	return FXSnapshot{Date: t, EUR: eur, USD: usd}, nil
+}
+
+var fxNotes = map[string]string{
+	"tr": "Yaklaşık tutar; ödeme TL ile alınır. Kur: TCMB döviz satış, %s.",
+	"en": "Approximate amount; payment is charged in Turkish lira. Rate: CBRT forex selling, %s.",
+	"de": "Ungefährer Betrag; bezahlt wird in türkischen Lira. Kurs: TCMB-Devisenverkaufskurs vom %s.",
+	"ru": "Сумма приблизительная; оплата производится в турецких лирах. Курс: ЦБ Турции, продажа валюты, %s.",
+}
+
+// ApproxFX returns "≈ 337,74 € · ≈ 377,45 $" style text and the localized
+// note for a TRY amount in kuruş. ok=false (zero snapshot) -> "", "".
+func (l *Localizer) ApproxFX(tryMinor int64, s FXSnapshot) (approx, note string) {
+	if s.EUR <= 0 || s.USD <= 0 || s.Date.IsZero() || tryMinor < 0 {
+		return "", ""
+	}
+	tl := float64(tryMinor) / 100
+	approx = "≈ " + l.Money(int64(math.Round(tl/s.EUR*100)), "EUR") + " · ≈ " + l.Money(int64(math.Round(tl/s.USD*100)), "USD")
+	n, ok := fxNotes[l.lang]
+	if !ok {
+		n = fxNotes["en"]
+	}
+	return approx, strings.Replace(n, "%s", l.Date(s.Date, time.UTC), 1)
+}
--- a/i18n/fx_test.go
+++ b/i18n/fx_test.go
@@ -0,0 +1,61 @@
+package i18n
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+const fxGood = `{"schema":"kanus.fx/1","source":"TCMB today.xml ForexSelling (döviz satış)","tcmb_tarih":"06.11.2026","date":"2026-11-06","base":"TRY","rates":{"USD":50.0724,"EUR":55.9609}}`
+
+var fxNow = time.Date(2026, 11, 8, 0, 37, 0, 0, time.UTC)
+
+func TestFXParseGood(t *testing.T) {
+	s, err := ParseFX([]byte(fxGood), fxNow)
+	if err != nil || s.EUR != 55.9609 || s.USD != 50.0724 || s.Date.Format("2006-01-02") != "2026-11-06" {
+		t.Fatalf("%v %+v", err, s)
+	}
+}
+
+func TestFXParseRejects(t *testing.T) {
+	for name, raw := range map[string]string{
+		"empty": ``, "json": `{`, "schema": strings.Replace(fxGood, "kanus.fx/1", "x", 1),
+		"base": strings.Replace(fxGood, `"TRY"`, `"USD"`, 1), "date": strings.Replace(fxGood, "2026-11-06", "06.11.2026", 2),
+		"string rate": strings.Replace(fxGood, `50.0724`, `"50.0724"`, 1), "zero": strings.Replace(fxGood, `50.0724`, `0`, 1),
+		"missing": strings.Replace(fxGood, `,"EUR":55.9609`, ``, 1), "extra": strings.Replace(fxGood, `}}`, `,"GBP":60}}`, 1),
+		"cross": strings.Replace(fxGood, `55.9609`, `155.9609`, 1), "huge": strings.Repeat(" ", 5000) + fxGood,
+	} {
+		if _, err := ParseFX([]byte(raw), fxNow); err == nil {
+			t.Errorf("%s accepted", name)
+		}
+	}
+	if _, err := ParseFX([]byte(fxGood), fxNow.Add(10*24*time.Hour)); err == nil {
+		t.Error("stale accepted")
+	}
+	if _, err := ParseFX([]byte(fxGood), fxNow.Add(-5*24*time.Hour)); err == nil {
+		t.Error("future accepted")
+	}
+}
+
+func TestFXApprox4Langs(t *testing.T) {
+	b, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, _ := ParseFX([]byte(fxGood), fxNow)
+	want := map[string][2]string{
+		"tr": {"≈ 337,74 € · ≈ 377,45 $", "ödeme TL ile alınır"},
+		"en": {"≈ 337.74 € · ≈ $377.45", "charged in Turkish lira"},
+		"de": {"≈ 337,74 € · ≈ 377,45 $", "türkischen Lira"},
+		"ru": {"≈ 337,74 € · ≈ 377,45 $", "турецких лирах"},
+	}
+	for lang, w := range want {
+		a, n := b.For(lang).ApproxFX(1890000, s)
+		if a != w[0] || !strings.Contains(n, w[1]) || !strings.Contains(n, "2026") {
+			t.Errorf("%s: %q %q", lang, a, n)
+		}
+	}
+	if a, n := b.For("tr").ApproxFX(1890000, FXSnapshot{}); a != "" || n != "" {
+		t.Error("zero snapshot must hide FX")
+	}
+}
