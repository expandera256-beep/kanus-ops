--- baseline_tree/safe_exec_unix_test.go	1970-01-01 02:00:00.000000000 +0200
+++ work2/kiyas/term/safe_exec_unix_test.go	2026-11-06 08:30:59.293250646 +0300
@@ -0,0 +1,72 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestSafeExecTimeoutKillsProcessGroup(t *testing.T) {
+	py := needPython(t)
+	root := t.TempDir()
+	pidFile := filepath.Join(root, "child.pid")
+	script := "import subprocess,sys,time\np=subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)'])\nopen('child.pid','w').write(str(p.pid))\nprint('ready',flush=True)\ntime.sleep(60)"
+	for _, mode := range []string{"timeout", "cancel"} {
+		_ = os.Remove(pidFile)
+		timeout := 30 * time.Second
+		if mode == "timeout" {
+			timeout = 1500 * time.Millisecond
+		}
+		sc, err := newSafeCmd(context.Background(), root, root, []string{py, "-c", script}, timeout)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := sc.Start(); err != nil {
+			t.Fatal(err)
+		}
+		deadline := time.Now().Add(10 * time.Second)
+		var childPid int
+		for time.Now().Before(deadline) {
+			if raw, err := os.ReadFile(pidFile); err == nil && len(raw) > 0 {
+				childPid, _ = strconv.Atoi(string(raw))
+				break
+			}
+			time.Sleep(20 * time.Millisecond)
+		}
+		if childPid == 0 {
+			t.Fatal("alt süreç pid yok")
+		}
+		if mode == "cancel" {
+			sc.Cancel()
+		}
+		start := time.Now()
+		state, _, _ := sc.Wait()
+		want := map[string]string{"timeout": "timeout", "cancel": "cancelled"}[mode]
+		if state != want {
+			t.Fatalf("%s: durum %s", mode, state)
+		}
+		if time.Since(start) > 8*time.Second {
+			t.Fatalf("%s: iptal gecikti", mode)
+		}
+		alive := true
+		for i := 0; i < 100 && alive; i++ {
+			// Reaped by init or zombie: both mean killed; check /proc state.
+			raw, err := os.ReadFile("/proc/" + strconv.Itoa(childPid) + "/stat")
+			alive = err == nil && !strings.Contains(string(raw), ") Z ") && syscall.Kill(childPid, 0) == nil
+			if alive {
+				time.Sleep(50 * time.Millisecond)
+			}
+		}
+		if alive {
+			_ = syscall.Kill(childPid, syscall.SIGKILL)
+			t.Fatalf("%s: torun süreç öldürülmedi (pid %d)", mode, childPid)
+		}
+	}
+}
diff -ruN -x kiyas -x '*.exe' baseline_tree/safe_limits_linux.go work2/kiyas/term/safe_limits_linux.go
--- baseline_tree/safe_limits_linux.go	1970-01-01 02:00:00.000000000 +0200
+++ work2/kiyas/term/safe_limits_linux.go	2026-11-06 08:31:10.213428061 +0300
@@ -0,0 +1,43 @@
+//go:build linux
+
+package main
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// applySafeLimits sets RLIMIT_CPU/DATA/FSIZE (DATA, not AS, so Go/V8 address-space reservations still work) on the started child via
+// prlimit(2). Children forked later inherit these limits.
+func applySafeLimits(proc *os.Process, l safeLimits) (func(), error) {
+	if proc == nil {
+		return func() {}, nil
+	}
+	set := func(res int, v uint64) error {
+		if v == 0 {
+			return nil
+		}
+		var cur unix.Rlimit
+		if err := unix.Prlimit(proc.Pid, res, nil, &cur); err != nil {
+			return err
+		}
+		if cur.Max != unix.RLIM_INFINITY && cur.Max < v {
+			v = cur.Max
+		}
+		return unix.Prlimit(proc.Pid, res, &unix.Rlimit{Cur: v, Max: v}, nil)
+	}
+	for _, item := range []struct {
+		res int
+		v   uint64
+	}{{unix.RLIMIT_CPU, l.CPUSeconds}, {unix.RLIMIT_DATA, l.MemoryBytes}, {unix.RLIMIT_FSIZE, l.FileBytes}} {
+		if err := set(item.res, item.v); err != nil {
+			return nil, err
+		}
+	}
+	// RLIMIT_NPROC is deliberately NOT set: on Linux it counts every
+	// thread of the real UID (the panel itself included), so a low value
+	// breaks threaded servers. Process count is bounded on Windows by the
+	// Job Object; on Linux use a cgroup/container for multi-tenant hosting.
+	return func() {}, nil
+}
