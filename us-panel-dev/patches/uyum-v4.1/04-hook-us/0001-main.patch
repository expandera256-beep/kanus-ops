--- a/cmd/us-license-hook/main.go
+++ b/cmd/us-license-hook/main.go
@@ -12,6 +12,7 @@
 	"strconv"
 	"time"
 
+	"kiyas/internal/privacy"
 	"kiyas/licensesrv"
 )
 
@@ -100,7 +101,47 @@
 		accounts.Workers = proxy.AccountWorkers
 	}
 	mux.Handle("/account/", accounts)
+	// UYUM privacy: thin mount. Prefs only if US_PRIVACY_PREFS_PATH set (optional). Erase off by default.
+	var prefStore privacy.PreferenceStore
+	prefsReady := true
+	if pp := os.Getenv("US_PRIVACY_PREFS_PATH"); pp != "" {
+		if privacy.OpenPrefStoreFunc == nil {
+			prefsReady = false
+			log.Print("privacy prefs unavailable; privacy readiness degraded")
+		} else if ps, err := privacy.OpenPrefStoreFunc(pp); err != nil {
+			prefsReady = false
+			log.Print("privacy prefs unavailable; privacy readiness degraded")
+		} else {
+			prefStore = ps
+		}
+	}
+	keepDays := privacy.RetentionDaysFromEnv()
+	privacy.Mount(mux, st, privacy.MountOptions{
+		Prefs:              prefStore,
+		EraseEnabled:       os.Getenv("US_PRIVACY_ERASE_ENABLED") == "1",
+		AdminToken:         os.Getenv("US_PRIVACY_ADMIN_TOKEN"),
+		KeepDays:           keepDays,
+		PrivacyUnavailable: !prefsReady,
+	})
+	// Preserve the exact legacy liveness contract. Readiness is a separate route.
 	mux.HandleFunc("/healthz", func(w http.ResponseWriter, _ *http.Request) { w.Write([]byte("ok")) })
+	mux.HandleFunc("/readyz", func(w http.ResponseWriter, _ *http.Request) {
+		if !prefsReady {
+			w.Header().Set("Retry-After", "60")
+			w.Header().Set("Content-Type", "application/json")
+			w.Header().Set("Cache-Control", "no-store")
+			w.WriteHeader(http.StatusServiceUnavailable)
+			w.Write([]byte(`{"status":"degraded","privacy":"unavailable"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		if prefStore == nil {
+			w.Write([]byte(`{"status":"ready","privacy":"not_configured"}`))
+		} else {
+			w.Write([]byte(`{"status":"ready","privacy":"available"}`))
+		}
+	})
 	return mux
 }
 
