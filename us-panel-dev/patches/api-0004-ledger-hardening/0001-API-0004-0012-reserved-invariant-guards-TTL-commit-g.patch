@@ -309,9 +353,13 @@ func (s *Store) settleFor(key, id string, commit bool, now time.Time) error {
 
 func (s *Store) expireLocked(now time.Time) {
 	for id, r := range s.st.Reservations {
-		if !now.Before(r.Expires) {
+		// Defer release until commit-grace after reservation Expires (api-0012).
