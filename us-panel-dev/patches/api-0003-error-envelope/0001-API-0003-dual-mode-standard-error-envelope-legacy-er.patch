diff --git a/licensesrv/api_error.go b/licensesrv/api_error.go
new file mode 100644
index 0000000..6c7fcee
--- /dev/null
+++ b/licensesrv/api_error.go
@@ -0,0 +1,74 @@
+package licensesrv
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"strings"
+)
+
+// ErrorBody is the standard API error envelope. The legacy "error" string field
+// is preserved for Round-7 clients; code/message/request_id are additive.
+type ErrorBody struct {
+	Error     string `json:"error"`
+	Code      string `json:"code"`
+	Message   string `json:"message"`
+	RequestID string `json:"request_id"`
+}
+
+func newRequestID() string {
+	b := make([]byte, 8)
+	if _, err := rand.Read(b); err != nil {
+		return "0000000000000000"
+	}
+	return hex.EncodeToString(b)
+}
+
+func wantsErrorEnvelope(r *http.Request) bool {
+	if r == nil {
+		return false
+	}
+	if strings.EqualFold(r.Header.Get("X-Kanus-Error-Envelope"), "1") {
+		return true
+	}
+	if r.URL != nil && r.URL.Query().Get("error_envelope") == "1" {
+		return true
+	}
+	accept := r.Header.Get("Accept")
+	return strings.Contains(accept, "application/json") || strings.Contains(accept, "application/problem+json")
+}
+
+// WriteAPIError writes a dual-mode error: JSON envelope when requested, else plain text
+// matching historical http.Error bodies (message + newline).
+func WriteAPIError(w http.ResponseWriter, r *http.Request, status int, code, message string) {
+	if message == "" {
+		message = http.StatusText(status)
+	}
+	if code == "" {
+		code = "request_rejected"
+	}
+	rid := newRequestID()
+	w.Header().Set("X-Request-Id", rid)
+	if wantsErrorEnvelope(r) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		w.WriteHeader(status)
+		_ = json.NewEncoder(w).Encode(ErrorBody{Error: message, Code: code, Message: message, RequestID: rid})
+		return
+	}
+	http.Error(w, message, status)
+}
+
+// WriteAccountError always returns JSON and keeps the legacy "error" string.
+func WriteAccountError(w http.ResponseWriter, status int, code, message string) {
+	if message == "" {
+		message = "account request rejected"
+	}
+	if code == "" {
+		code = "account_rejected"
+	}
+	rid := newRequestID()
+	w.Header().Set("X-Request-Id", rid)
+	accountJSON(w, status, ErrorBody{Error: message, Code: code, Message: message, RequestID: rid})
+}
diff --git a/licensesrv/api_error_test.go b/licensesrv/api_error_test.go
new file mode 100644
index 0000000..564fc08
--- /dev/null
+++ b/licensesrv/api_error_test.go
@@ -0,0 +1,44 @@
+package licensesrv
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestAPIErrorEnvelopeJSONAdditiveAndPlainFallback(t *testing.T) {
+	r := httptest.NewRequest("POST", "/v1/credits/reserve", nil)
+	r.Header.Set("Accept", "application/json")
+	w := httptest.NewRecorder()
+	WriteAPIError(w, r, 402, "insufficient_credit", "reserve")
+	if w.Code != 402 || w.Header().Get("X-Request-Id") == "" {
+		t.Fatal(w.Code, w.Header())
+	}
+	var body ErrorBody
+	if json.Unmarshal(w.Body.Bytes(), &body) != nil || body.Error != "reserve" || body.Code != "insufficient_credit" || body.Message != "reserve" || body.RequestID == "" {
+		t.Fatal(w.Body.String())
+	}
+	// Plain fallback preserves http.Error shape (message + newline).
+	r2 := httptest.NewRequest("POST", "/v1/credits/reserve", nil)
+	w2 := httptest.NewRecorder()
+	WriteAPIError(w2, r2, 401, "unauthorized", "license")
+	if w2.Code != 401 || w2.Body.String() != "license\n" {
+		t.Fatal(w2.Code, w2.Body.String())
+	}
+}
+
+func TestAccountErrorKeepsLegacyErrorField(t *testing.T) {
+	w := httptest.NewRecorder()
+	WriteAccountError(w, 401, "unauthorized", "account request rejected")
+	var body ErrorBody
+	if w.Code != 401 || json.Unmarshal(w.Body.Bytes(), &body) != nil {
+		t.Fatal(w.Code, w.Body.String())
+	}
+	if body.Error != "account request rejected" || body.Code != "unauthorized" || body.RequestID == "" {
+		t.Fatal(body)
+	}
+	if !strings.Contains(w.Body.String(), `"error":"account request rejected"`) {
+		t.Fatal("legacy field missing")
+	}
+}
