diff -ruN -x kiyas -x '*.exe' snap_item3/task_state.go work2/kiyas/term/task_state.go
--- snap_item3/task_state.go	1970-01-01 02:00:00.000000000 +0200
+++ work2/kiyas/term/task_state.go	2026-11-06 08:44:19.607496680 +0300
@@ -0,0 +1,203 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"time"
+)
+
+// Persistent, versioned, atomic JSON state for the agent build/fix loop so a
+// task can resume after a crash or restart without re-applying edits,
+// re-running completed phases, or silently replaying a paid model call.
+
+const taskStateVersion = 1
+
+type taskState struct {
+	Version      int           `json:"version"`
+	ID           string        `json:"id"`
+	Root         string        `json:"root"`
+	Model        string        `json:"model"`
+	Phase        string        `json:"phase"` // checking, model_call, applying, done
+	Result       repairResult  `json:"result"`
+	PendingEdits []pendingEdit `json:"pendingEdits,omitempty"`
+	UpdatedAt    time.Time     `json:"updatedAt"`
+}
+
+type pendingEdit struct {
+	Path    string `json:"path"`
+	Content string `json:"content"`
+	Hash    string `json:"hash"`
+	Applied bool   `json:"applied"`
+}
+
+var taskIDPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)
+
+func taskStatePath(root, id string) (string, error) {
+	if !taskIDPattern.MatchString(id) {
+		return "", errors.New("geçersiz görev kimliği")
+	}
+	return filepath.Join(root, taskDir, "agent", id+".json"), nil
+}
+
+func saveTaskState(st *taskState) error {
+	path, err := taskStatePath(st.Root, st.ID)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(path)
+	for _, d := range []string{filepath.Join(st.Root, taskDir), dir} {
+		if info, err := os.Lstat(d); err == nil && (!info.IsDir() || info.Mode()&os.ModeSymlink != 0) {
+			return errors.New("görev klasörü geçersiz")
+		}
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	st.Version = taskStateVersion
+	st.UpdatedAt = time.Now().UTC()
+	raw, err := json.MarshalIndent(st, "", " ")
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(dir, ".state-*")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	defer os.Remove(tmp)
+	if err = f.Chmod(0o600); err == nil {
+		_, err = f.Write(raw)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	if c := f.Close(); err == nil {
+		err = c
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(tmp, path); err != nil {
+		return err
+	}
+	syncDir(dir)
+	return nil
+}
+
+// loadTaskState returns (nil, nil) when no state exists. A corrupt or
+// foreign file is preserved as <id>.json.corrupt-<ts> and reported.
+func loadTaskState(root, id string) (*taskState, error) {
+	path, err := taskStatePath(root, id)
+	if err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(path)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 16<<20 {
+		return nil, errors.New("görev durumu okunamadı")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var st taskState
+	if json.Unmarshal(raw, &st) != nil || st.Version != taskStateVersion || st.ID != id || st.Root != root {
+		keep := fmt.Sprintf("%s.corrupt-%d", path, time.Now().UnixNano())
+		_ = os.Rename(path, keep)
+		return nil, fmt.Errorf("görev durumu bozuk; korundu: %s", filepath.Base(keep))
+	}
+	return &st, nil
+}
+
+// errUncertainModelCall: the process stopped while a model request was in
+// flight. It is not replayed automatically because it may have been billed.
+var errUncertainModelCall = errors.New("önceki model isteğinin sonucu belirsiz; otomatik tekrar yapılmadı")
+
+// runPersistentRepair runs (or resumes) a repair loop whose every state
+// change is checkpointed atomically. allowReplay must be set explicitly by
+// the user to re-issue an in-flight model call after a crash.
+func runPersistentRepair(ctx context.Context, l *repairLoop, id string, allowReplay bool) (*repairResult, error) {
+	st, err := loadTaskState(l.Root, id)
+	if err != nil {
+		return nil, err
+	}
+	if st == nil {
+		st = &taskState{ID: id, Root: l.Root, Model: l.Model, Phase: "checking"}
+	} else {
+		switch {
+		case st.Phase == "done":
+			r := st.Result
+			return &r, nil
+		case st.Phase == "model_call" && !allowReplay:
+			return nil, errUncertainModelCall
+		case st.Phase == "model_call":
+			// User approved a replay: the uncounted call stays counted.
+		}
+		if len(st.PendingEdits) > 0 {
+			ft, err := newFileTools(l.Root)
+			if err != nil {
+				return nil, err
+			}
+			for i := range st.PendingEdits {
+				e := &st.PendingEdits[i]
+				cur, err := ft.Read(e.Path)
+				if err == nil && hashContent(cur) == e.Hash {
+					e.Applied = true // already on disk: never write twice
+					continue
+				}
+				if _, err := recordChange(ft.Root, filepath.ToSlash(e.Path), []byte(e.Content)); err != nil {
+					return nil, err
+				}
+				if err := ft.Write(e.Path, []byte(e.Content)); err != nil {
+					return nil, err
+				}
+				e.Applied = true
+			}
+			var names []string
+			for _, e := range st.PendingEdits {
+				names = append(names, e.Path)
+			}
+			st.Result.Steps = append(st.Result.Steps, repairStep{Iteration: st.Result.Iterations, State: "applied", ExitCode: -1, Edits: names, Note: "devam: bekleyen düzeltme tamamlandı"})
+			st.PendingEdits = nil
+		}
+		st.Phase = "checking"
+		if err := saveTaskState(st); err != nil {
+			return nil, err
+		}
+		resume := st.Result
+		l.resume = &resume
+	}
+	l.hooks = &repairHooks{
+		beforeModel: func(r *repairResult) error {
+			st.Result, st.Phase = *r, "model_call"
+			return saveTaskState(st)
+		},
+		beforeApply: func(r *repairResult, edits []repairEdit) error {
+			st.Result, st.Phase = *r, "applying"
+			st.PendingEdits = nil
+			for _, e := range edits {
+				st.PendingEdits = append(st.PendingEdits, pendingEdit{Path: e.Path, Content: e.Content, Hash: hashContent([]byte(e.Content))})
+			}
+			return saveTaskState(st)
+		},
+	}
+	l.Checkpoint = func(r *repairResult) error {
+		st.Result = *r
+		st.PendingEdits = nil
+		st.Phase = "checking"
+		switch r.Status {
+		case "running":
+		default:
+			st.Phase = "done"
+		}
+		return saveTaskState(st)
+	}
+	return l.Run(ctx)
+}
diff -ruN -x kiyas -x '*.exe' snap_item3/task_state_test.go work2/kiyas/term/task_state_test.go
--- snap_item3/task_state_test.go	1970-01-01 02:00:00.000000000 +0200
+++ work2/kiyas/term/task_state_test.go	2026-11-06 08:44:51.971730487 +0300
@@ -0,0 +1,145 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const utilFixed = "package main\n\nfunc helper() int { return 1 }\n"
+
+func twoFileFix() string {
+	return `{"files":[{"path":"main.go","content":` + jsonString(fixedMain) + `},{"path":"util.go","content":` + jsonString(utilFixed) + `}]}`
+}
+
+func jsonString(s string) string {
+	r := strings.NewReplacer(`\`, `\\`, `"`, `\"`, "\n", `\n`, "\t", `\t`)
+	return `"` + r.Replace(s) + `"`
+}
+
+func crashTestLoop(root, url string) *repairLoop {
+	return &repairLoop{Root: root, Endpoint: url, Key: "test-key", Model: "mock",
+		Budget:  repairBudget{MaxIterations: 3, MaxModelCalls: 3, MaxDuration: 2 * time.Minute, StepTimeout: time.Minute, MaxEditBytes: 1 << 16},
+		Approve: func(int, []repairEdit) bool { return true }}
+}
+
+// Child process body: runs the persistent loop and hard-exits at the crash
+// point, like a killed panel process (no deferred cleanup, no final save).
+func TestTaskStateCrashChild(t *testing.T) {
+	point := os.Getenv("US_TASK_CRASH_POINT")
+	if point == "" {
+		t.Skip("yalnız çökme simülasyonu alt süreci")
+	}
+	repairCrashHook = func(p string) {
+		if p == point {
+			os.Exit(3)
+		}
+	}
+	_, _ = runPersistentRepair(context.Background(), crashTestLoop(os.Getenv("US_TASK_CRASH_ROOT"), os.Getenv("US_TASK_CRASH_URL")), "gorev1", false)
+	os.Exit(0)
+}
+
+func runCrashChild(t *testing.T, root, url, point string) {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestTaskStateCrashChild$", "-test.count=1")
+	cmd.Env = append(os.Environ(), "US_TASK_CRASH_POINT="+point, "US_TASK_CRASH_ROOT="+root, "US_TASK_CRASH_URL="+url)
+	out, err := cmd.CombinedOutput()
+	var exit *exec.ExitError
+	if !errors.As(err, &exit) || exit.ExitCode() != 3 {
+		t.Fatalf("alt süreç çökme noktasında durmadı (%s): %v\n%s", point, err, out)
+	}
+}
+
+func historyCount(t *testing.T, root, rel string) int {
+	entries, _ := os.ReadDir(filepath.Join(root, changeHistoryDir))
+	n := 0
+	for _, e := range entries {
+		raw, _ := os.ReadFile(filepath.Join(root, changeHistoryDir, e.Name()))
+		if strings.Contains(string(raw), `"path":"`+rel+`"`) || strings.Contains(string(raw), `"Path":"`+rel+`"`) {
+			n++
+		}
+	}
+	return n
+}
+
+func TestTaskStateResumeAfterCrashMidApply(t *testing.T) {
+	root := brokenGoProject(t)
+	if err := os.WriteFile(filepath.Join(root, "util.go"), []byte("package main\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	srv, calls := mockModel(t, func(string, int) string { return twoFileFix() })
+	runCrashChild(t, root, srv.URL, "mid_apply")
+	if *calls != 1 {
+		t.Fatalf("çökme öncesi model çağrısı %d", *calls)
+	}
+	st, err := loadTaskState(root, "gorev1")
+	if err != nil || st == nil || st.Phase != "applying" || len(st.PendingEdits) != 2 {
+		t.Fatalf("kalıcı durum yanlış: %+v %v", st, err)
+	}
+	if got, _ := os.ReadFile(filepath.Join(root, "main.go")); string(got) != fixedMain {
+		t.Fatal("ilk dosya çökme öncesi yazılmamış")
+	}
+	if got, _ := os.ReadFile(filepath.Join(root, "util.go")); string(got) == utilFixed {
+		t.Fatal("ikinci dosya beklenmedik şekilde yazılmış")
+	}
+	res, err := runPersistentRepair(context.Background(), crashTestLoop(root, srv.URL), "gorev1", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Status != "fixed" || *calls != 1 || res.ModelCalls != 1 {
+		t.Fatalf("devam yanlış: %s calls=%d modelCalls=%d", res.Status, *calls, res.ModelCalls)
+	}
+	if historyCount(t, root, "main.go") != 1 || historyCount(t, root, "util.go") != 1 {
+		t.Fatalf("düzeltme çift uygulandı: main=%d util=%d", historyCount(t, root, "main.go"), historyCount(t, root, "util.go"))
+	}
+	if got, _ := os.ReadFile(filepath.Join(root, "util.go")); string(got) != utilFixed {
+		t.Fatal("bekleyen düzeltme tamamlanmadı")
+	}
+	// Completed task is not re-run.
+	again, err := runPersistentRepair(context.Background(), crashTestLoop(root, srv.URL), "gorev1", false)
+	if err != nil || again.Status != "fixed" || *calls != 1 {
+		t.Fatalf("tamamlanan görev tekrarlandı: %+v %v", again, err)
+	}
+}
+
+func TestTaskStateUncertainModelCallNotReplayed(t *testing.T) {
+	root := brokenGoProject(t)
+	srv, calls := mockModel(t, func(string, int) string { return fileJSON("main.go", fixedMain) })
+	runCrashChild(t, root, srv.URL, "model_in_flight")
+	if _, err := runPersistentRepair(context.Background(), crashTestLoop(root, srv.URL), "gorev1", false); !errors.Is(err, errUncertainModelCall) {
+		t.Fatalf("belirsiz istek otomatik tekrarlandı: %v", err)
+	}
+	if *calls != 0 {
+		t.Fatalf("model çağrıldı: %d", *calls)
+	}
+	res, err := runPersistentRepair(context.Background(), crashTestLoop(root, srv.URL), "gorev1", true)
+	if err != nil || res.Status != "fixed" || *calls != 1 {
+		t.Fatalf("onaylı tekrar başarısız: %+v %v calls=%d", res, err, *calls)
+	}
+}
+
+func TestTaskStateCorruptFileIsPreserved(t *testing.T) {
+	root := t.TempDir()
+	path, _ := taskStatePath(root, "bozuk")
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("{yarım"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if st, err := loadTaskState(root, "bozuk"); err == nil || st != nil {
+		t.Fatal("bozuk kayıt kabul edildi")
+	}
+	matches, _ := filepath.Glob(path + ".corrupt-*")
+	if len(matches) != 1 {
+		t.Fatal("bozuk kayıt korunmadı")
+	}
+	if _, err := taskStatePath(root, "../x"); err == nil {
+		t.Fatal("kimlik ile yol kaçışı")
+	}
+}
