+++ b/licensesrv/fx_test.go
@@ -0,0 +1,62 @@
+package licensesrv
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const tcmbXML = `<?xml version="1.0" encoding="UTF-8"?><Tarih_Date Tarih="06.11.2026" Date="11/06/2026" Bulten_No="2026/209"><Currency CrossOrder="0" Kod="USD" CurrencyCode="USD"><Unit>1</Unit><ForexSelling>50.0724</ForexSelling></Currency><Currency CrossOrder="9" Kod="EUR" CurrencyCode="EUR"><Unit>1</Unit><ForexSelling>55.9609</ForexSelling></Currency></Tarih_Date>`
+
+func TestFXProposal(t *testing.T) {
+	dir := t.TempDir()
+	s := &FXStore{Path: filepath.Join(dir, "fx.json"), Now: func() time.Time { return time.Date(2026, 11, 8, 12, 0, 0, 0, time.UTC) }}
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest("GET", "/v1/fx", nil))
+	var e map[string]string
+	if w.Code != 503 || w.Header().Get("Cache-Control") != "no-store" || json.Unmarshal(w.Body.Bytes(), &e) != nil || e["error"] != "fx_unavailable" || e["code"] != "fx_unavailable" || e["request_id"] == "" {
+		t.Fatal("503 envelope", w.Code, w.Body.String())
+	}
+	if err := s.Update([]byte(tcmbXML)); err != nil {
+		t.Fatal(err)
+	}
+	w = httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest("GET", "/v1/fx", nil))
+	b := w.Body.String()
+	if w.Code != 200 || w.Header().Get("Cache-Control") != "public, max-age=3600" || !strings.Contains(b, `"EUR":55.9609`) || !strings.Contains(b, `"rate_type":"forex_selling"`) || strings.Contains(b, "sig") {
+		t.Fatal(w.Code, b)
+	}
+	for name, bad := range map[string]string{
+		"missing EUR": strings.Replace(tcmbXML, `CurrencyCode="EUR"`, `CurrencyCode="EUX"`, 1),
+		"range":       strings.Replace(tcmbXML, "55.9609", "5555.9609", 1),
+		"cross":       strings.Replace(tcmbXML, "55.9609", "155.9609", 1),
+		"future":      strings.Replace(tcmbXML, "06.11.2026", "09.11.2026", 1),
+		"older":       strings.Replace(tcmbXML, "06.11.2026", "05.11.2026", 1),
+		"junk":        "<x/>",
+	} {
+		if err := s.Update([]byte(bad)); err == nil {
+			t.Errorf("%s accepted", name)
+		}
+	}
+	// stale but valid: still 200 (freshness is the panel's decision); restart reload
+	s.Now = func() time.Time { return time.Date(2026, 11, 30, 12, 0, 0, 0, time.UTC) }
+	s2 := &FXStore{Path: s.Path}
+	s2.Load()
+	w = httptest.NewRecorder()
+	s2.ServeHTTP(w, httptest.NewRequest("HEAD", "/v1/fx", nil))
+	if w.Code != 200 || w.Body.Len() != 0 {
+		t.Fatal("restart/HEAD", w.Code)
+	}
+	w = httptest.NewRecorder()
+	s2.ServeHTTP(w, httptest.NewRequest("POST", "/v1/fx", nil))
+	if w.Code != 405 {
+		t.Fatal(w.Code)
+	}
+	if _, err := os.Stat(s.Path); err != nil {
+		t.Fatal(err)
+	}
+}
