+func TestR13WindowsRootSwapPinned(t *testing.T) {
+	p := t.TempDir()
+	root, old, out := filepath.Join(p, "root"), filepath.Join(p, "old"), filepath.Join(p, "outside")
+	for _, dir := range []string{root, out} {
