+		t.Fatalf("desk: %q %v %v", text, ok, complete)
+	}
+	if _, err := undoLastChange(root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(target); !os.IsNotExist(err) {
+		t.Fatal("new file undo failed")
+	}
+}
