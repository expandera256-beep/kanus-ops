diff --git a/gui_i18n_test.go b/gui_i18n_test.go
new file mode 100644
index 0000000..953e306
--- /dev/null
+++ b/gui_i18n_test.go
@@ -0,0 +1,80 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"testing"
+
+	"kiyas/i18n"
+)
+
+// TR markup must equal tr.json so the default (TR) panel is unchanged.
+func TestGUIDataI18nMatchesTurkishDefault(t *testing.T) {
+	b, err := i18n.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	tr := b.For("tr")
+	page := string(guiPage)
+	re := regexp.MustCompile(`data-i18n="([^"]+)">([^<]*)<`)
+	ms := re.FindAllStringSubmatch(page, -1)
+	if len(ms) < 30 {
+		t.Fatalf("expected >=30 translatable elements, got %d", len(ms))
+	}
+	for _, m := range ms {
+		if got := tr.T(m[1]); got != m[2] {
+			t.Errorf("%s: markup %q != tr.json %q", m[1], m[2], got)
+		}
+		if en := b.For("en").T(m[1]); en == m[1] || en == "" {
+			t.Errorf("%s: no English text", m[1])
+		}
+	}
+	for _, m := range regexp.MustCompile(`placeholder="([^"]*)"[^>]*data-i18n-ph="([^"]+)"`).FindAllStringSubmatch(page, -1) {
+		if got := tr.T(m[2]); got != m[1] {
+			t.Errorf("%s: placeholder %q != %q", m[2], m[1], got)
+		}
+	}
+	for _, want := range []string{`<html lang="tr">`, `<title>US</title>`, `id="langsel"`, `fetch("/api/i18n"`, `document.documentElement.dir`} {
+		if !strings.Contains(page, want) {
+			t.Errorf("page missing %q", want)
+		}
+	}
+}
+
+func TestGUII18nEndpoint(t *testing.T) {
+	s := newView("i18n")
+	s.root = t.TempDir()
+	h := guiMux(&s)
+	for _, c := range []struct{ q, lang, sample string }{
+		{"", "tr", "Dosya"}, {"?lang=en", "en", "Files"}, {"?lang=xx", "tr", "Dosya"}, {"?lang=EN-us", "en", "Files"},
+	} {
+		req := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/api/i18n"+c.q, nil)
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != 200 {
+			t.Fatalf("%s: status %d", c.q, rec.Code)
+		}
+		var d i18n.Document
+		if err := json.Unmarshal(rec.Body.Bytes(), &d); err != nil {
+			t.Fatal(err)
+		}
+		if d.Lang != c.lang || d.Messages["gui.nav.files"] != c.sample || d.Dir != "ltr" || len(d.Languages) < 2 {
+			t.Errorf("%s: got lang=%s dir=%s sample=%q", c.q, d.Lang, d.Dir, d.Messages["gui.nav.files"])
+		}
+	}
+	req := httptest.NewRequest(http.MethodPost, "http://127.0.0.1/api/i18n", nil)
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusMethodNotAllowed {
+		t.Errorf("POST status %d", rec.Code)
+	}
+	req = httptest.NewRequest(http.MethodGet, "http://evil.example/api/i18n", nil)
+	rec = httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusForbidden {
+		t.Errorf("foreign host status %d", rec.Code)
+	}
+}
diff --git a/i18n/http.go b/i18n/http.go
new file mode 100644
index 0000000..a182ede
--- /dev/null
+++ b/i18n/http.go
@@ -0,0 +1,69 @@
+package i18n
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// LangInfo describes one selectable language.
+type LangInfo struct {
+	Code string `json:"code"`
+	Name string `json:"name"`
+	Dir  string `json:"dir"`
+}
+
+// Document is the JSON payload served to the panel UI.
+type Document struct {
+	Lang      string            `json:"lang"`
+	Dir       string            `json:"dir"`
+	BCP47     string            `json:"bcp47"`
+	Languages []LangInfo        `json:"languages"`
+	Messages  map[string]string `json:"messages"`
+}
+
+// Doc builds the UI document for lang with fallback-resolved messages.
+func (b *Bundle) Doc(lang string) Document {
+	l := b.For(lang)
+	b.mu.RLock()
+	keys := make([]string, 0, len(b.cats[Default].msgs))
+	for k := range b.cats[Default].msgs {
+		keys = append(keys, k)
+	}
+	langs := make([]LangInfo, 0, len(b.cats))
+	b.mu.RUnlock()
+	for _, code := range b.Languages() {
+		m := b.For(code).Meta()
+		langs = append(langs, LangInfo{Code: code, Name: m.Name, Dir: m.Dir})
+	}
+	msgs := make(map[string]string, len(keys))
+	for _, k := range keys {
+		msgs[k] = l.T(k)
+	}
+	m := l.Meta()
+	return Document{Lang: l.Lang(), Dir: m.Dir, BCP47: m.BCP47, Languages: langs, Messages: msgs}
+}
+
+// Handler serves GET /api/i18n?lang=xx. Without lang it negotiates from
+// the resolver (user preference) and Accept-Language; default is TR.
+func Handler(pref func() string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			w.Header().Set("Allow", http.MethodGet)
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		b, err := Load()
+		if err != nil {
+			http.Error(w, "i18n unavailable", http.StatusInternalServerError)
+			return
+		}
+		p := r.URL.Query().Get("lang")
+		if p == "" && pref != nil {
+			p = pref()
+		}
+		lang := b.Negotiate(p, "") // unknown or empty -> Default (TR)
+		w.Header().Set("Content-Type", "application/json; charset=utf-8")
+		w.Header().Set("Cache-Control", "no-store")
+		_ = json.NewEncoder(w).Encode(b.Doc(lang))
+	})
+}
