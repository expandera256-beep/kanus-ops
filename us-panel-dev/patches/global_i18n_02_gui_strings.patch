+// i18n: dynamic language switching; TR markup is the default and stays untouched until another language is chosen.
+const i18nState = { lang: "tr" };
+function applyLocale(doc) {
+  const msgs = doc.messages || {};
+  document.querySelectorAll("[data-i18n]").forEach(el => { const v = msgs[el.dataset.i18n]; if (typeof v === "string") el.textContent = v; });
+  document.querySelectorAll("[data-i18n-ph]").forEach(el => { const v = msgs[el.dataset.i18nPh]; if (typeof v === "string") el.placeholder = v; });
+  document.documentElement.lang = doc.lang || "tr";
+  document.documentElement.dir = doc.dir === "rtl" ? "rtl" : "ltr";
+  i18nState.lang = doc.lang || "tr";
+  const sel = document.querySelector("#langsel");
+  if (sel && Array.isArray(doc.languages)) {
+    sel.replaceChildren(...doc.languages.map(l => { const o = document.createElement("option"); o.value = l.code; o.textContent = l.name; return o; }));
+    sel.value = i18nState.lang;
+  }
+}
+function loadLocale(lang) {
+  const q = lang ? "?lang=" + encodeURIComponent(lang) : "";
+  return fetch("/api/i18n" + q, { cache: "no-store" }).then(r => r.ok ? r.json() : null).then(doc => { if (doc) applyLocale(doc); }).catch(() => {});
+}
