+
+// creditRequestError carries only retry classification, never credentials.
+type creditRequestError struct {
+	transient bool
+	message   string
+}
+
+func (e *creditRequestError) Error() string { return e.message }
+
+// settle retries the SAME id and decision, which settleFor already makes
+// idempotent. Never release after an uncertain commit: it could have succeeded.
+// The cleanup deadline is independent of a cancelled model request.
+func (g creditGate) settle(id string, commit bool) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 31*time.Second)
+	defer cancel()
+	payload := map[string]any{"id": id, "commit": commit}
+	var err error
+	for attempt := 0; attempt < 3; attempt++ {
+		if attempt > 0 {
+			timer := time.NewTimer(time.Duration(attempt) * 100 * time.Millisecond)
+			select {
+			case <-timer.C:
+			case <-ctx.Done():
+				timer.Stop()
+				return ctx.Err()
+			}
+		}
+		err = g.request(ctx, "/v1/credits/settle", payload, nil)
+		if err == nil {
+			return nil
+		}
+		var failure *creditRequestError
+		if !errors.As(err, &failure) || !failure.transient || ctx.Err() != nil {
+			return err
+		}
+	}
+	return err
+}
