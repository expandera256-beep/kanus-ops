+// commitGraceFromEnv reads US_CREDIT_COMMIT_GRACE_SECONDS (default 600 = 10m).
+// Set to 0 for legacy immediate expire-at-TTL behavior.
+// Cap: 900s (15m, KAN.US) — clamp above max to 900 (not reset to default).
+// Longer holds pin Reserved after client crashes; invalid/negative/unparseable → 600.
+func commitGraceFromEnv() time.Duration {
+	const defSeconds int64 = 600
+	const maxSeconds int64 = 900
+	raw := strings.TrimSpace(os.Getenv("US_CREDIT_COMMIT_GRACE_SECONDS"))
+	if raw == "" {
+		return time.Duration(defSeconds) * time.Second
+	}
+	// Parse as int64 seconds and clamp BEFORE multiplying into a Duration,
+	// so huge values cannot overflow (PANEL DEV R3-A01).
+	n, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil || n < 0 {
+		n = defSeconds
+	} else if n > maxSeconds {
+		n = maxSeconds
+	}
+	return time.Duration(n) * time.Second
+}
+
+func (s *Store) reservationCommitDeadline(r *Reservation) time.Time {
+	if s.commitGrace <= 0 {
+		return r.Expires
+	}
+	return r.Expires.Add(s.commitGrace)
+}
+
+// applyReservedDelta adjusts Reserved and returns an error if it would go negative.
+// On error, the license Reserved field is left unchanged (no panic).
+func applyReservedDelta(l *License, delta int) error {
+	next := l.Reserved + delta
+	if next < 0 {
+		return errors.New("reserved invariant violated")
+	}
+	l.Reserved = next
+	return nil
+}
