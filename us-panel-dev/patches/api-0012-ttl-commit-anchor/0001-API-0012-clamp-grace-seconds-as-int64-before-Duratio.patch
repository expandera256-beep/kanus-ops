From 53fd6c405c6b29af077e88d37cde16cff3931ddf Mon Sep 17 00:00:00 2001
From: API <api@local>
Date: Sun, 8 Nov 2026 00:56:14 +0300
Subject: [PATCH 1/2] API-0012: clamp grace seconds as int64 before Duration
 multiply (R3-A01 overflow)

---
 licensesrv/grace_overflow_test.go | 29 +++++++++++++++++++++++++++++
 licensesrv/store.go               | 20 ++++++++++----------
 2 files changed, 39 insertions(+), 10 deletions(-)
 create mode 100644 licensesrv/grace_overflow_test.go

diff --git a/licensesrv/grace_overflow_test.go b/licensesrv/grace_overflow_test.go
new file mode 100644
index 0000000..d53d5aa
--- /dev/null
+++ b/licensesrv/grace_overflow_test.go
@@ -0,0 +1,29 @@
+package licensesrv
+
+import (
+	"testing"
+	"time"
+)
+
+// PANEL DEV R3-A01: 16 uç durum (PANEL_API_REVIEW_R3FIX_20261106.md).
+func TestCommitGraceFromEnvOverflowEdges(t *testing.T) {
+	def, max := 10*time.Minute, 15*time.Minute
+	cases := []struct {
+		in   string
+		want time.Duration
+	}{
+		{"", def}, {" ", def}, {"0", 0}, {"-0", 0}, {"-1", def},
+		{"900", max}, {"901", max}, {"+901", max}, {" 901 ", max},
+		{"1s", def}, {"abc", def}, {"9999999999999999999999999", def},
+		{"9223372036", max}, {"9223372037", max}, {"18446744074", max},
+		{"9223372036854775807", max},
+	}
+	for _, c := range cases {
+		t.Run(c.in, func(t *testing.T) {
+			t.Setenv("US_CREDIT_COMMIT_GRACE_SECONDS", c.in)
+			if got := commitGraceFromEnv(); got != c.want {
+				t.Fatalf("input=%q got=%v want=%v", c.in, got, c.want)
+			}
+		})
+	}
+}
diff --git a/licensesrv/store.go b/licensesrv/store.go
index 4c246e1..2a9be15 100644
--- a/licensesrv/store.go
+++ b/licensesrv/store.go
@@ -244,21 +244,21 @@ func (s *Store) transactionLocked(fn func() error) error {
 // Cap: 900s (15m, KAN.US) — clamp above max to 900 (not reset to default).
 // Longer holds pin Reserved after client crashes; invalid/negative/unparseable → 600.
 func commitGraceFromEnv() time.Duration {
-	const def = 10 * time.Minute
-	const maxGrace = 15 * time.Minute
+	const defSeconds int64 = 600
+	const maxSeconds int64 = 900
 	raw := strings.TrimSpace(os.Getenv("US_CREDIT_COMMIT_GRACE_SECONDS"))
 	if raw == "" {
-		return def
+		return time.Duration(defSeconds) * time.Second
 	}
-	n, err := strconv.Atoi(raw)
+	// Parse as int64 seconds and clamp BEFORE multiplying into a Duration,
+	// so huge values cannot overflow (PANEL DEV R3-A01).
+	n, err := strconv.ParseInt(raw, 10, 64)
 	if err != nil || n < 0 {
-		return def
+		n = defSeconds
+	} else if n > maxSeconds {
+		n = maxSeconds
 	}
-	d := time.Duration(n) * time.Second
-	if d > maxGrace {
-		return maxGrace
-	}
-	return d
+	return time.Duration(n) * time.Second
 }
 
 func (s *Store) reservationCommitDeadline(r *Reservation) time.Time {
